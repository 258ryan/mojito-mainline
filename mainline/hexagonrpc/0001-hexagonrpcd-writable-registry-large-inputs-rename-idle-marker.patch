diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..cc51139 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -277,3 +277,113 @@ int hexagonfs_fstat(struct hexagonfs_fd **fds, int fileno, struct stat *stats)
 
 	return fd->ops->stat(fd, stats);
 }
+
+/*
+ * Open the directory holding the last segment of path and point leaf at that
+ * segment. Returns the directory's file number.
+ */
+static int open_parent(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		       const char *path, const char **leaf)
+{
+	const char *slash = strrchr(path, '/');
+	char *parent;
+	int ret, i;
+
+	if (slash == NULL || !slash[1] || !strcmp(slash + 1, ".")
+	 || !strcmp(slash + 1, ".."))
+		return -EINVAL;
+
+	*leaf = slash + 1;
+
+	parent = strndup(path, slash == path ? 1 : slash - path);
+	if (parent == NULL)
+		return -ENOMEM;
+
+	ret = hexagonfs_openat(fds, rootfd, dirfd, parent);
+	free(parent);
+	if (ret < 0)
+		return ret;
+
+	/* a path resolving to an already open directory would alias it */
+	for (i = 0; i < HEXAGONFS_MAX_FD; i++) {
+		if (i != ret && fds[i] == fds[ret]) {
+			fds[ret] = NULL;
+			return -EINVAL;
+		}
+	}
+
+	return ret;
+}
+
+int hexagonfs_create(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		     const char *path, bool append)
+{
+	struct hexagonfs_fd *dir, *file;
+	const char *leaf;
+	int parent, ret;
+
+	parent = open_parent(fds, rootfd, dirfd, path, &leaf);
+	if (parent < 0)
+		return parent;
+
+	dir = fds[parent];
+	if (dir->ops->create == NULL)
+		ret = -EROFS;
+	else
+		ret = dir->ops->create(dir, leaf, append, &file);
+
+	hexagonfs_close(fds, parent);
+	if (ret)
+		return ret;
+
+	ret = allocate_file_number(fds, file);
+	if (ret < 0)
+		destroy_file_descriptor(file);
+
+	return ret;
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->write == NULL)
+		return -EROFS;
+
+	return fd->ops->write(fd, size, ptr);
+}
+
+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		     const char *oldpath, const char *newpath)
+{
+	const char *oldleaf, *newleaf;
+	int olddir, newdir, ret;
+
+	olddir = open_parent(fds, rootfd, dirfd, oldpath, &oldleaf);
+	if (olddir < 0)
+		return olddir;
+
+	newdir = open_parent(fds, rootfd, dirfd, newpath, &newleaf);
+	if (newdir < 0) {
+		hexagonfs_close(fds, olddir);
+		return newdir;
+	}
+
+	if (fds[olddir]->ops->rename == NULL || fds[newdir]->ops != fds[olddir]->ops)
+		ret = -EROFS;
+	else
+		ret = fds[olddir]->ops->rename(fds[olddir], oldleaf,
+					       fds[newdir], newleaf);
+
+	hexagonfs_close(fds, olddir);
+	hexagonfs_close(fds, newdir);
+
+	return ret;
+}
