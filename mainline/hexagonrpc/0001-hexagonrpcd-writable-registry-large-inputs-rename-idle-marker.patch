+static int mapped_create(struct hexagonfs_fd *dir, const char *name, bool append,
+			 struct hexagonfs_fd **out)
+{
+	struct mapped_ctx *dir_ctx = dir->data;
+	struct hexagonfs_fd *fd;
+	struct mapped_ctx *ctx;
+	int flags = O_RDWR | O_CREAT | O_NOFOLLOW | (append ? O_APPEND : O_TRUNC);
+	int ret;
+
+	ctx = malloc(sizeof(struct mapped_ctx));
+	fd = malloc(sizeof(struct hexagonfs_fd));
+	if (ctx == NULL || fd == NULL) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	ctx->fd = openat(dir_ctx->fd, name, flags, 0644);
+	if (ctx->fd == -1) {
+		ret = -errno;
+		goto err;
+	}
+
+	ctx->dir = NULL;
+
+	fd->is_assigned = false;
+	fd->up = NULL;
+	fd->ops = dir->ops;
+	fd->data = ctx;
+
+	*out = fd;
+
+	return 0;
+
+err:
+	free(fd);
+	free(ctx);
+	return ret;
+}
+
+static ssize_t mapped_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	struct mapped_ctx *ctx = fd->data;
+	const char *buf = ptr;
+	size_t done = 0;
+	ssize_t ret;
+
+	while (done < size) {
+		ret = write(ctx->fd, buf + done, size - done);
+		if (ret < 0)
+			return -errno;
+
+		done += ret;
+	}
+
+	return done;
+}
+
+static int mapped_rename(struct hexagonfs_fd *olddir, const char *oldname,
+			 struct hexagonfs_fd *newdir, const char *newname)
+{
+	struct mapped_ctx *old_ctx = olddir->data;
+	struct mapped_ctx *new_ctx = newdir->data;
+
+	if (renameat(old_ctx->fd, oldname, new_ctx->fd, newname))
+		return -errno;
+
+	return 0;
+}
+
+struct hexagonfs_file_ops hexagonfs_mapped_rw_ops = {
+	.close = mapped_close,
+	.from_dirent = mapped_from_dirent,
+	.openat = mapped_openat,
+	.read = mapped_read,
+	.readdir = mapped_readdir,
+	.seek = mapped_seek,
+	.stat = mapped_stat,
+	.create = mapped_create,
+	.write = mapped_write,
+	.rename = mapped_rename,
+};
