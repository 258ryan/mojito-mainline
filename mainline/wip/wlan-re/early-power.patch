diff -ru ath10k.orig/snoc.c ath10k/snoc.c
--- ath10k.orig/snoc.c	2026-11-27 00:29:10.593293883 +0500
+++ ath10k/snoc.c	2026-11-27 00:29:19.310945774 +0500
@@ -6,6 +6,7 @@
 
 #include <linux/bits.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
@@ -1066,6 +1067,38 @@
 	return ret_vreg ? : ret_seq;
 }
 
+/* TEST: power the radio when the WLFW service appears, as stock icnss does. */
+static bool early_power;
+module_param(early_power, bool, 0644);
+MODULE_PARM_DESC(early_power, "TEST: enable pwrseq/regulators before the first WLFW request");
+
+static uint early_delay_ms;
+module_param(early_delay_ms, uint, 0644);
+MODULE_PARM_DESC(early_delay_ms, "TEST: wait after early power-on before continuing");
+
+static bool early_powered;
+
+void ath10k_snoc_early_power(struct ath10k *ar, bool on)
+{
+	int ret;
+
+	if (on == early_powered || (on && !early_power))
+		return;
+
+	if (on) {
+		ret = ath10k_hw_power_on(ar);
+		ath10k_info(ar, "early_power: on, ret %d, delay %u ms\n", ret, early_delay_ms);
+		if (ret)
+			return;
+		early_powered = true;
+		msleep(early_delay_ms);
+	} else {
+		ret = ath10k_hw_power_off(ar);
+		ath10k_info(ar, "early_power: off, ret %d\n", ret);
+		early_powered = false;
+	}
+}
+
 static void ath10k_snoc_wlan_disable(struct ath10k *ar)
 {
 	struct ath10k_snoc *ar_snoc = ath10k_snoc_priv(ar);
@@ -1904,6 +1937,7 @@
