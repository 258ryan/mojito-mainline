+ * tells us what type of charger we're connected to.
+ */
+static int smb5_apsd_get_charger_type(struct smb5_chip *chip, int *val)
+{
+	unsigned int apsd_stat, stat;
+	int usb_online = 0;
+	int rc;
+
+	rc = smb5_get_prop_usb_online(chip, &usb_online);
+	if (!usb_online) {
+		*val = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+		return rc;
+	}
+
+	rc = regmap_read(chip->regmap, chip->base + APSD_STATUS, &apsd_stat);
+	if (rc < 0) {
+		dev_err(chip->dev, "Failed to read apsd status, rc = %d", rc);
+		return rc;
+	}
+	if (!(apsd_stat & APSD_DTC_STATUS_DONE_BIT)) {
+		dev_err(chip->dev, "Apsd not ready");
+		return -EAGAIN;
+	}
+
+	rc = regmap_read(chip->regmap, chip->base + APSD_RESULT_STATUS, &stat);
+	if (rc < 0) {
+		dev_err(chip->dev, "Failed to read apsd result, rc = %d", rc);
+		return rc;
+	}
+
+	stat &= APSD_RESULT_STATUS_MASK;
+
+	if (stat & CDP_CHARGER_BIT){
+		*val = POWER_SUPPLY_USB_TYPE_CDP;
+	} else if (stat & DCP_CHARGER_BIT){
+		*val = POWER_SUPPLY_USB_TYPE_DCP;
+	} else if (stat & OCP_CHARGER_BIT){
+		*val = POWER_SUPPLY_USB_TYPE_DCP;
+	} else if (stat & FLOAT_CHARGER_BIT){
+		/* data lines not recognised: usually an SDP detected too early */
+		*val = POWER_SUPPLY_USB_TYPE_SDP;
+	} else if (stat & QC_2P0_BIT){
+		*val = POWER_SUPPLY_USB_TYPE_DCP;
+	} else if (stat & QC_3P0_BIT){
+		*val = POWER_SUPPLY_USB_TYPE_DCP;
+	} else {
+		*val = POWER_SUPPLY_USB_TYPE_SDP;
+	}
+
+	return 0;
+}
+
+static int smb5_get_prop_charging_enabled(struct smb5_chip *chip, int *val)
+{
+	unsigned int charging_enabled;
+	int rc = regmap_read(chip->regmap, chip->base + CHARGING_ENABLE_CMD, &charging_enabled);
+	if (rc < 0) {
+		dev_err(chip->dev, "Failed to read charging enabled status, rc = %d", rc);
+		return rc;
+	}
+	*val = charging_enabled & CHARGING_ENABLE_CMD_BIT ? 1 : 0;
+	return 0;
+}
+
+static int smb5_get_prop_status(struct smb5_chip *chip, int *val)
+{
+	unsigned char stat[2];
+	int usb_online = 0;
+	int rc;
+
+	rc = smb5_get_prop_usb_online(chip, &usb_online);
+	if (!usb_online) {
+		*val = POWER_SUPPLY_STATUS_DISCHARGING;
+		return rc;
+	}
+
+	rc = regmap_bulk_read(chip->regmap,
+			      chip->base + BATTERY_CHARGER_STATUS_1, &stat, 2);
+	if (rc < 0) {
+		dev_err(chip->dev, "Failed to read charging status ret=%d\n",
+			rc);
+		return rc;
+	}
+
+	/*
+	 * The charge state comes first: near full VBATT_GTET_INHIBIT is set
+	 * while the charger is still in taper and current flows into the
+	 * battery, so it must not turn an active charge into "not charging".
+	 */
+	stat[0] = stat[0] & BATTERY_CHARGER_STATUS_MASK;
+
+	switch (stat[0]) {
+	case TRICKLE_CHARGE:
+	case PRE_CHARGE:
+	case FAST_CHARGE:
+	case FULLON_CHARGE:
+	case TAPER_CHARGE:
+		*val = POWER_SUPPLY_STATUS_CHARGING;
+		return rc;
+	case DISABLE_CHARGE:
+		*val = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return rc;
+	case TERMINATE_CHARGE:
+	case INHIBIT_CHARGE:
+		*val = POWER_SUPPLY_STATUS_FULL;
+		return rc;
+	default:
+		*val = POWER_SUPPLY_STATUS_UNKNOWN;
+		return rc;
+	}
+}
+
+static inline int smb5_get_current_limit(struct smb5_chip *chip,
+					 unsigned int *val)
+{
+	int rc = regmap_read(chip->regmap, chip->base + AICL_STATUS, val);
+
+	if (rc >= 0)
+		*val *= CURRENT_SCALE_FACTOR;
+	return rc;
+}
+
+static int smb5_set_current_limit(struct smb5_chip *chip, unsigned int val)
+{
+	unsigned char val_raw;
+	int rc;
+
+	if (val > CURRENT_MAX_UA) {
+		dev_err(chip->dev,
+			"Can't set current limit higher than %d uA", CURRENT_MAX_UA);
+		return -EINVAL;
+	}
+	val_raw = val / CURRENT_SCALE_FACTOR;
+
+	rc = regmap_write(chip->regmap, chip->base + USBIN_CURRENT_LIMIT_CFG,
+			  val_raw);
+	if (rc)
+		return rc;
+
+	/*
+	 * The limit register only applies in high-current mode with the ICL
+	 * taken over after APSD (the vendor's SW_OVERRIDE_HC_MODE). In the
+	 * hardware-automatic mode left by the init sequence an SDP port gets
+	 * the 100 mA USB default and this register is ignored.
+	 */
+	rc = regmap_update_bits(chip->regmap, chip->base + USBIN_ICL_OPTIONS,
+				USBIN_MODE_CHG_BIT, USBIN_MODE_CHG_BIT);
+	if (rc)
+		return rc;
+	rc = regmap_update_bits(chip->regmap, chip->base + CMD_ICL_OVERRIDE,
+				ICL_OVERRIDE_BIT, 0);
+	if (rc)
+		return rc;
+	return regmap_update_bits(chip->regmap, chip->base + USBIN_LOAD_CFG,
+				  ICL_OVERRIDE_AFTER_APSD_BIT,
+				  ICL_OVERRIDE_AFTER_APSD_BIT);
+}
+
+static int smb5_set_prop_charging_enabled(struct smb5_chip *chip, unsigned int val)
+{
+	return regmap_update_bits(chip->regmap, chip->base + CHARGING_ENABLE_CMD,
+					CHARGING_ENABLE_CMD_BIT, val ? CHARGING_ENABLE_CMD_BIT : 0);
+}
+
+/*
+ * SDP (and FLOAT, which is usually an SDP): USB 2.0 500 mA in USB51 mode, as
+ * the vendor's set_sdp_current(). In high-current mode the hardware holds an
+ * SDP to the 100 mA USB default. Unlike the vendor code the ICL override is
+ * left clear: on PM6150 (Redmi Note 10) setting it here suspends USBIN
+ * (POWER_PATH_STATUS bit 6) until the input is re-armed. The input is then
+ * unsuspended and AICL re-run, which also recovers such a latched suspend.
+ */
+static int smb5_set_sdp_current(struct smb5_chip *chip, bool is_float)
+{
+	int rc;
+
+	if (is_float) {
+		rc = regmap_update_bits(chip->regmap, chip->base + USBIN_OPTIONS_2_CFG,
+					FORCE_FLOAT_SDP_CFG_BIT, FORCE_FLOAT_SDP_CFG_BIT);
+		if (rc)
+			return rc;
+	}
+	rc = regmap_update_bits(chip->regmap, chip->base + USBIN_ICL_OPTIONS,
+				CFG_USB3P0_SEL_BIT | USB51_MODE_BIT | USBIN_MODE_CHG_BIT,
+				USB51_MODE_BIT);
+	if (rc)
+		return rc;
+	rc = regmap_update_bits(chip->regmap, chip->base + CMD_ICL_OVERRIDE,
+				ICL_OVERRIDE_BIT, 0);
+	if (rc)
+		return rc;
+	rc = regmap_update_bits(chip->regmap, chip->base + USBIN_LOAD_CFG,
+				ICL_OVERRIDE_AFTER_APSD_BIT, 0);
+	if (rc)
+		return rc;
+	rc = regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
+				USBIN_SUSPEND_BIT, 0);
+	if (rc)
+		return rc;
+	return regmap_write(chip->regmap, chip->base + AICL_CMD, RERUN_AICL_BIT);
+}
+
+static void smb5_status_change_work(struct work_struct *work)
+{
+	unsigned int charger_type, current_ua;
+	int usb_online = 0;
+	int count, rc;
+	struct smb5_chip *chip;
+
+	chip = container_of(work, struct smb5_chip, status_change_work.work);
+
+	smb5_get_prop_usb_online(chip, &usb_online);
+	if (!usb_online)
+		return;
+
+	for (count = 0; count < 3; count++) {
+		dev_dbg(chip->dev, "get charger type retry %d\n", count);
+		rc = smb5_apsd_get_charger_type(chip, &charger_type);
+		if (rc != -EAGAIN)
+			break;
+		msleep(100);
+	}
+
+	if (rc < 0 && rc != -EAGAIN) {
+		dev_err(chip->dev, "get charger type failed: %d\n", rc);
+		return;
+	}
+
+	if (rc < 0) {
+		rc = regmap_update_bits(chip->regmap, chip->base + CMD_APSD,
+					APSD_RERUN_BIT, APSD_RERUN_BIT);
+		schedule_delayed_work(&chip->status_change_work,
+				      msecs_to_jiffies(1000));
+		dev_dbg(chip->dev, "get charger type failed, rerun apsd\n");
+		return;
+	}
+
+	switch (charger_type) {
+	case POWER_SUPPLY_USB_TYPE_CDP:
+		current_ua = CDP_CURRENT_UA;
+		break;
+	case POWER_SUPPLY_USB_TYPE_DCP:
+		current_ua = DCP_CURRENT_UA;
+		break;
+	case POWER_SUPPLY_USB_TYPE_SDP:
+	default:
+		regmap_read(chip->regmap, chip->base + APSD_RESULT_STATUS, &current_ua);
+		smb5_set_sdp_current(chip, current_ua & FLOAT_CHARGER_BIT);
+		power_supply_changed(chip->chg_psy);
+		return;
+	}
+
+	smb5_set_current_limit(chip, current_ua);
+	power_supply_changed(chip->chg_psy);
+}
+
+static int smb5_get_iio_chan(struct smb5_chip *chip, struct iio_channel *chan,
+			     int *val)
+{
+	int rc;
+	union power_supply_propval status;
+
+	rc = power_supply_get_property(chip->chg_psy, POWER_SUPPLY_PROP_STATUS,
+				       &status);
+	if (rc < 0 || status.intval != POWER_SUPPLY_STATUS_CHARGING) {
+		*val = 0;
+		return 0;
+	}
+
+	if (IS_ERR(chan)) {
+		dev_err(chip->dev, "Failed to chan, err = %li", PTR_ERR(chan));
+		return PTR_ERR(chan);
+	}
+
+	return iio_read_channel_processed(chan, val);
+}
+
+static int smb5_get_prop_health(struct smb5_chip *chip, int *val)
+{
+	int rc;
+	unsigned int stat;
+
+	rc = regmap_read(chip->regmap, chip->base + BATTERY_CHARGER_STATUS_2,
+			 &stat);
+	if (rc < 0) {
+		dev_err(chip->dev, "Couldn't read charger status rc=%d\n", rc);
+		return rc;
+	}
+
+	if (stat & CHARGER_ERROR_STATUS_BAT_OV_BIT) {
+		dev_err(chip->dev, "battery over-voltage");
+	}
+
+	rc = regmap_read(chip->regmap, chip->base + BATTERY_CHARGER_STATUS_7_REG,
+			 &stat);
+	if (rc < 0) {
+		dev_err(chip->dev, "Couldn't read charger status 7 rc=%d\n", rc);
+		return rc;
+	}
+
+	if (stat & BAT_TEMP_STATUS_TOO_COLD_BIT)
+		*val = POWER_SUPPLY_HEALTH_COLD;
+	else if (stat & BAT_TEMP_STATUS_TOO_HOT_BIT)
+		*val = POWER_SUPPLY_HEALTH_OVERHEAT;
+	else if (stat & BAT_TEMP_STATUS_COLD_SOFT_BIT)
+		*val = POWER_SUPPLY_HEALTH_COOL;
+	else if (stat & BAT_TEMP_STATUS_HOT_SOFT_BIT)
+		*val = POWER_SUPPLY_HEALTH_WARM;
+	else
+		*val = POWER_SUPPLY_HEALTH_GOOD;
+
+	return 0;
+}
+
+static int smb5_get_property(struct power_supply *psy,
+			     enum power_supply_property psp,
+			     union power_supply_propval *val)
+{
+	struct smb5_chip *chip = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = "Qualcomm";
+		return 0;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = chip->name;
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		return smb5_get_current_limit(chip, &val->intval);
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		return smb5_get_iio_chan(chip, chip->usb_in_i_chan,
+					 &val->intval);
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		return smb5_get_iio_chan(chip, chip->usb_in_v_chan,
+					 &val->intval);
+	case POWER_SUPPLY_PROP_ONLINE:
+		return smb5_get_prop_usb_online(chip, &val->intval);
+	case POWER_SUPPLY_PROP_STATUS:
+		return smb5_get_prop_status(chip, &val->intval);
+	case POWER_SUPPLY_PROP_HEALTH:
+		return smb5_get_prop_health(chip, &val->intval);
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		return smb5_apsd_get_charger_type(chip, &val->intval);
+	case POWER_SUPPLY_PROP_CHARGING_ENABLED:
+		return smb5_get_prop_charging_enabled(chip, &val->intval);
+	default:
+		dev_err(chip->dev, "invalid property: %d\n", psp);
+		return -EINVAL;
+	}
+}
+
+static int smb5_set_property(struct power_supply *psy,
+			     enum power_supply_property psp,
+			     const union power_supply_propval *val)
+{
+	struct smb5_chip *chip = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		return smb5_set_current_limit(chip, val->intval);
+	case POWER_SUPPLY_PROP_CHARGING_ENABLED:
+		return smb5_set_prop_charging_enabled(chip, val->intval);
+	default:
+		dev_err(chip->dev, "No setter for property: %d\n", psp);
+		return -EINVAL;
+	}
+}
+
+static int smb5_property_is_writable(struct power_supply *psy,
+				     enum power_supply_property psp)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+	case POWER_SUPPLY_PROP_CHARGING_ENABLED:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static irqreturn_t smb5_handle_batt_overvoltage(int irq, void *data)
+{
+	struct smb5_chip *chip = data;
+	unsigned int status;
+
+	regmap_read(chip->regmap, chip->base + BATTERY_CHARGER_STATUS_2,
+		    &status);
+
+	if (status & CHARGER_ERROR_STATUS_BAT_OV_BIT) {
+		/* The hardware stops charging automatically */
+		dev_err(chip->dev, "battery overvoltage detected\n");
+		power_supply_changed(chip->chg_psy);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t smb5_handle_usb_plugin(int irq, void *data)
+{
+	struct smb5_chip *chip = data;
+
+	power_supply_changed(chip->chg_psy);
+
+	schedule_delayed_work(&chip->status_change_work,
+			      msecs_to_jiffies(1500));
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t smb5_handle_usb_icl_change(int irq, void *data)
+{
+	struct smb5_chip *chip = data;
+
+	power_supply_changed(chip->chg_psy);
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t smb5_handle_wdog_bark(int irq, void *data)
+{
+	struct smb5_chip *chip = data;
+	int rc;
+
+	power_supply_changed(chip->chg_psy);
+
+	rc = regmap_write(chip->regmap, chip->base + BARK_BITE_WDOG_PET,
+			  BARK_BITE_WDOG_PET_BIT);
+	if (rc < 0)
+		dev_err(chip->dev, "Couldn't pet the dog rc=%d\n", rc);
+
+	return IRQ_HANDLED;
+}
+
+static const struct power_supply_desc smb5_psy_desc = {
+	.name = "pm8150b_charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_SDP) |
+		     BIT(POWER_SUPPLY_USB_TYPE_CDP) |
+		     BIT(POWER_SUPPLY_USB_TYPE_DCP) |
+		     BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN),
+	.properties = smb5_properties,
+	.num_properties = ARRAY_SIZE(smb5_properties),
+	.get_property = smb5_get_property,
+	.set_property = smb5_set_property,
+	.property_is_writeable = smb5_property_is_writable,
+};
+
+/* Init sequence derived from vendor downstream driver */
+static const struct smb5_register smb5_init_seq[] = {
+	{ .addr = USBIN_CMD_IL, .mask = USBIN_SUSPEND_BIT, .val = 0 },
+	{ .addr = AICL_RERUN_TIME_CFG, .mask = AICL_RERUN_TIME_MASK, .val = 0 },
+	/*
+	 * Type-C (0x15xx) and OTG registers are deliberately left as the
+	 * bootloader set them: rewriting them can drop the USB link, which on
+	 * phones like the Redmi Note 10 is the only connection to the host.
+	 */
+	/*
+	 * Use VBAT to determine the recharge threshold when battery is full
+	 * rather than the state of charge.
+	 */
+	{ .addr = CHARGE_RCHG_SOC_THRESHOLD_CFG_REG,
+	  .mask = CHARGE_RCHG_SOC_THRESHOLD_CFG_MASK,
+	  .val = 98 },
+	/* Enable charging */
+	{ .addr = CHARGING_ENABLE_CMD,
+	  .mask = CHARGING_ENABLE_CMD_BIT,
+	  .val = CHARGING_ENABLE_CMD_BIT },
+	/* Enable BC1P2 Src detect */
+	{ .addr = USBIN_OPTIONS_1_CFG,
+	  .mask = BC1P2_SRC_DETECT_BIT,
+	  .val = BC1P2_SRC_DETECT_BIT },
+	/* Set the default SDP charger type to a 500ma USB 2.0 port */
+	{ .addr = USBIN_ICL_OPTIONS,
+	  .mask = USBIN_MODE_CHG_BIT,
+	  .val = USBIN_MODE_CHG_BIT },
+	{ .addr = CMD_ICL_OVERRIDE,
+	  .mask = ICL_OVERRIDE_BIT,
+	  .val = 0 },
+	{ .addr = USBIN_LOAD_CFG,
+	  .mask = ICL_OVERRIDE_AFTER_APSD_BIT,
+	  .val = 0 },
+	/* Disable watchdog */
+	{ .addr = SNARL_BARK_BITE_WD_CFG, .mask = 0xff, .val = 0 },
+	{ .addr = WD_CFG,
+	  .mask = WATCHDOG_TRIGGER_AFP_EN_BIT | WDOG_TIMER_EN_ON_PLUGIN_BIT |
+		  BARK_WDOG_INT_EN_BIT | WDOG_TIMER_EN_BIT,
+	  .val = 0 },
+	/*
+	 * Enable Automatic Input Current Limit, this will slowly ramp up the current
+	 * When connected to a wall charger, and automatically stop when it detects
+	 * the charger current limit (voltage drop?) or it reaches the programmed limit.
+	 */
+	{ .addr = USBIN_AICL_OPTIONS_CFG,
+	  .mask = USBIN_AICL_PERIODIC_RERUN_EN_BIT | USBIN_AICL_ADC_EN_BIT
+			| USBIN_AICL_EN_BIT | SUSPEND_ON_COLLAPSE_USBIN_BIT,
+	  .val = USBIN_AICL_PERIODIC_RERUN_EN_BIT | USBIN_AICL_ADC_EN_BIT
+			| USBIN_AICL_EN_BIT | SUSPEND_ON_COLLAPSE_USBIN_BIT },
+};
+
+static int smb5_init_hw(struct smb5_chip *chip)
+{
+	int rc, i;
+	for (i = 0; i < ARRAY_SIZE(smb5_init_seq); i++) {
+		dev_dbg(chip->dev, "%d: Writing 0x%02x to 0x%02x\n", i,
+			smb5_init_seq[i].val, smb5_init_seq[i].addr);
+		rc = regmap_update_bits(chip->regmap,
+					chip->base + smb5_init_seq[i].addr,
+					smb5_init_seq[i].mask,
+					smb5_init_seq[i].val);
+		if (rc < 0)
+			return dev_err_probe(chip->dev, rc,
+					     "%s: init command %d failed\n",
+					     __func__, i);
+	}
+	return 0;
+}
+
+static int smb5_init_irq(struct smb5_chip *chip, int *irq, const char *name,
+			 irqreturn_t (*handler)(int irq, void *data))
+{
+	int irqnum;
+	int rc;
+
+	irqnum = platform_get_irq_byname(to_platform_device(chip->dev), name);
+	if (irqnum < 0)
+		return irqnum;
+
+	rc = devm_request_threaded_irq(chip->dev, irqnum, NULL, handler,
+				       IRQF_ONESHOT, name, chip);
+	if (rc < 0)
+		return dev_err_probe(chip->dev, rc, "Couldn't request irq %s\n",
+				     name);
+
+	if (irq)
+		*irq = irqnum;
+
+	return 0;
+}
+
+static int smb5_probe(struct platform_device *pdev)
+{
+	struct power_supply_config supply_config = {};
+	struct power_supply_desc *desc;
+	struct smb5_chip *chip;
+	int rc, irq, float_voltage_uv;
+
+	chip = devm_kzalloc(&pdev->dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+
+	chip->dev = &pdev->dev;
+	chip->name = pdev->name;
+
+	chip->regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!chip->regmap)
+		return dev_err_probe(chip->dev, -ENODEV,
+				     "failed to locate the regmap\n");
+
+	rc = device_property_read_u32(chip->dev, "reg", &chip->base);
+	if (rc < 0)
+		return dev_err_probe(chip->dev, rc,
+				     "Couldn't read base address\n");
+
+	chip->usb_in_v_chan = devm_iio_channel_get(chip->dev, "usb_in_v_div_16");
+	if (IS_ERR(chip->usb_in_v_chan))
+		return dev_err_probe(chip->dev, PTR_ERR(chip->usb_in_v_chan),
+				     "Couldn't get usb_in_v_div_16 IIO channel\n");
+
+	chip->usb_in_i_chan = devm_iio_channel_get(chip->dev, "usb_in_i_uv");
+	if (IS_ERR(chip->usb_in_i_chan)) {
+		return dev_err_probe(chip->dev, PTR_ERR(chip->usb_in_i_chan),
+				     "Couldn't get usb_in_i_uv IIO channel\n");
+	}
+
+	rc = smb5_init_hw(chip);
+	if (rc < 0)
+		return rc;
+
+	supply_config.drv_data = chip;
+	supply_config.fwnode = pdev->dev.fwnode;
+
+	desc = devm_kzalloc(chip->dev, sizeof(smb5_psy_desc), GFP_KERNEL);
+	if (!desc)
+		return -ENOMEM;
+	memcpy(desc, &smb5_psy_desc, sizeof(smb5_psy_desc));
+	desc->name =
+		devm_kasprintf(chip->dev, GFP_KERNEL, "%s-charger",
+			       (const char *)device_get_match_data(chip->dev));
+	if (!desc->name)
+		return -ENOMEM;
+
+	chip->chg_psy =
+		devm_power_supply_register(chip->dev, desc, &supply_config);
+	if (IS_ERR(chip->chg_psy))
+		return dev_err_probe(chip->dev, PTR_ERR(chip->chg_psy),
+				     "failed to register power supply\n");
+
+	rc = power_supply_get_battery_info(chip->chg_psy, &chip->batt_info);
+	if (rc)
+		return dev_err_probe(chip->dev, rc,
+				     "Failed to get battery info\n");
+
+	rc = devm_delayed_work_autocancel(chip->dev, &chip->status_change_work,
+					  smb5_status_change_work);
+	if (rc)
+		return dev_err_probe(chip->dev, rc,
+				     "Failed to init status change work\n");
+
+	float_voltage_uv = chip->batt_info->voltage_max_design_uv;
+	if (float_voltage_uv < FLOAT_VOLTAGE_MIN_UV || float_voltage_uv > FLOAT_VOLTAGE_MAX_UV)
+		return dev_err_probe(chip->dev, -EINVAL,
+				     "Requested voltage %d uV outside valid range [%d, %d] uV\n",
+				     float_voltage_uv, FLOAT_VOLTAGE_MIN_UV, FLOAT_VOLTAGE_MAX_UV);
+	rc = (float_voltage_uv - FLOAT_VOLTAGE_MIN_UV) / FLOAT_VOLTAGE_STEP_UV;
+	rc = regmap_update_bits(chip->regmap, chip->base + FLOAT_VOLTAGE_CFG,
+				FLOAT_VOLTAGE_SETTING_MASK, rc);
+	if (rc < 0)
+		return dev_err_probe(chip->dev, rc, "Couldn't set vbat max\n");
+
+	/* fast-charge current from the battery node, 50 mA steps, at most 3 A */
+	if (chip->batt_info->constant_charge_current_max_ua > 0) {
+		unsigned int fcc = min(chip->batt_info->constant_charge_current_max_ua,
+				       3000000);
+
+		rc = regmap_update_bits(chip->regmap,
+					chip->base + FAST_CHARGE_CURRENT_CFG,
+					FAST_CHARGE_CURRENT_SETTING_MASK,
+					fcc / CURRENT_SCALE_FACTOR);
+		if (rc < 0)
+			return dev_err_probe(chip->dev, rc, "Couldn't set fcc\n");
+	}
+
+	rc = smb5_init_irq(chip, &irq, "bat-ov", smb5_handle_batt_overvoltage);
+	if (rc < 0)
+		return rc;
+
+	rc = smb5_init_irq(chip, &chip->cable_irq, "usbin-plugin",
+			   smb5_handle_usb_plugin);
+	if (rc < 0)
+		return rc;
+
+	rc = smb5_init_irq(chip, &irq, "usbin-icl-change",
+			   smb5_handle_usb_icl_change);
+	if (rc < 0)
+		return rc;
+	rc = smb5_init_irq(chip, &irq, "wdog-bark", smb5_handle_wdog_bark);
+	if (rc < 0)
+		return rc;
+
+	rc = devm_pm_set_wake_irq(chip->dev, chip->cable_irq);
+	if (rc < 0)
+		return dev_err_probe(chip->dev, rc, "Couldn't set wake irq\n");
+
+	platform_set_drvdata(pdev, chip);
+
+	/* Initialise charger state */
+	schedule_delayed_work(&chip->status_change_work, 0);
+
+	return 0;
+}
+
+static const struct of_device_id smb5_match_id_table[] = {
+	{ .compatible = "qcom,pm8150b-charger", .data = "pm8150b" },
+	{ /* sentinal */ }
+};
+MODULE_DEVICE_TABLE(of, smb5_match_id_table);
+
+static struct platform_driver qcom_spmi_smb5 = {
+	.probe = smb5_probe,
+	.driver = {
+		.name = "qcom-pm8150b-charger",
+		.of_match_table = smb5_match_id_table,
+		},
+};
+
+module_platform_driver(qcom_spmi_smb5);
+
+MODULE_AUTHOR("Caleb Connolly <caleb.connolly@linaro.org>");
+MODULE_DESCRIPTION("Qualcomm SMB5 Charger Driver");
+MODULE_IMPORT_NS("IIO_CONSUMER");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/qcom_qg_lite.c b/drivers/power/supply/qcom_qg_lite.c
new file mode 100644
index 000000000..796bda1ad
--- /dev/null
+++ b/drivers/power/supply/qcom_qg_lite.c
@@ -0,0 +1,537 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal, read-only battery driver for the Qualcomm QGauge (QG) block found in
+ * PM6150/PM7150B/PMI632-class PMICs.
+ *
+ * It does not program the QG: the bootloader (XBL) leaves it running and
+ * measuring, and this driver only reads the battery voltage and current it
+ * reports. The only write is the reported SOC into the QG SDAM byte the
+ * vendor driver also keeps it in, so the next boot starts from it. The state of charge is started from the value the previous OS left
+ * in the QG SDAM (or from the OCV table if that is missing), followed by
+ * coulomb counting, and slowly pulled toward the OCV-table estimate
+ * (voltage + I x R) whenever the current is low. Battery data (OCV tables,
+ * design capacity, internal resistance) comes from a "simple-battery" node.
+ *
+ * Register layout and scaling follow the vendor driver (qg-reg.h, qg-util.c).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/devm-helpers.h>
+#include <linux/iio/consumer.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define QG_PERPH_SUBTYPE		0x05
+#define QG_SUBTYPE_IBAT_5A		0x03
+#define QG_STATUS1			0x08
+#define  QG_STATUS1_OK			BIT(7)
+#define  QG_STATUS1_BATT_PRESENT	BIT(0)
+#define QG_LAST_ADC_V			0xc0
+#define QG_LAST_BURST_AVG_I		0xc6
+
+#define SDAM_VALID			0x46
+#define SDAM_SOC			0x47
+#define SDAM_LEARNED_CAP		0x68	/* 2 bytes, mAh */
+
+#define QG_POLL_MS			5000
+#define QG_V_UV_PER_LSB_X1000		194637ULL
+#define QG_I_UA_PER_LSB_X1000_5A	152588LL
+#define QG_I_UA_PER_LSB_X1000_10A	305176LL
+#define QG_DEFAULT_RBAT_UOHM		150000
+#define QG_REST_CURRENT_UA		100000
+#define QG_DIR_CURRENT_UA		20000
+#define QG_STATUS_CURRENT_UA		50000
+#define QG_USBIN_ONLINE_UV		4000000
+
+struct qg_lite {
+	struct device *dev;
+	struct regmap *regmap;
+	u32 base;
+	u32 sdam_base;
+	bool has_sdam;
+	s64 i_scale;
+
+	struct power_supply *psy;
+	struct power_supply_battery_info *info;
+	struct iio_channel *temp_chan;
+	struct iio_channel *usbin_chan;
+	struct power_supply *chg_psy;	/* "power-supplies" charger, looked up lazily */
+	bool no_chg_psy;
+	struct delayed_work work;
+	struct mutex lock;
+	int learned_uah;	/* from SDAM, 0 if unusable */
+
+	/* state, protected by lock */
+	bool ready;
+	int vbat_uv;
+	int ibat_ua;		/* QG convention: positive = discharging */
+	int temp_dc;		/* tenths of a degree C */
+	int ocv_uv;
+	s64 charge_nah;		/* coulomb counter */
+	int soc_x100;		/* internal SOC, 0..10000 */
+	int soc_reported;	/* 0..100, the value userspace sees */
+	int status;
+	int status_cand;
+	ktime_t last;
+};
+
+static int qg_read_u16(struct qg_lite *qg, u32 reg, u16 *val)
+{
+	u8 buf[2];
+	int ret;
+
+	ret = regmap_bulk_read(qg->regmap, qg->base + reg, buf, 2);
+	if (ret)
+		return ret;
+	*val = buf[0] | (buf[1] << 8);
+	return 0;
+}
+
+static int qg_read_vi(struct qg_lite *qg, int *v_uv, int *i_ua)
+{
+	u16 raw;
+	int ret;
+
+	ret = qg_read_u16(qg, QG_LAST_ADC_V, &raw);
+	if (ret)
+		return ret;
+	*v_uv = div_u64(QG_V_UV_PER_LSB_X1000 * raw, 1000);
+
+	ret = qg_read_u16(qg, QG_LAST_BURST_AVG_I, &raw);
+	if (ret)
+		return ret;
+	*i_ua = div_s64(qg->i_scale * sign_extend32(raw, 15), 1000);
+	return 0;
+}
+
+static int qg_temp_dc(struct qg_lite *qg)
+{
+	int mdeg;
+
+	if (qg->temp_chan && !iio_read_channel_processed(qg->temp_chan, &mdeg))
+		return mdeg / 100;
+	return 250;
+}
+
+static int qg_usbin_online(struct qg_lite *qg)
+{
+	int uv;
+
+	if (!qg->usbin_chan || iio_read_channel_processed(qg->usbin_chan, &uv))
+		return -ENODATA;
+	return uv > QG_USBIN_ONLINE_UV;
+}
+
+static int qg_design_uah(struct qg_lite *qg)
+{
+	return qg->info->charge_full_design_uah > 0 ?
+	       qg->info->charge_full_design_uah : 5000000;
+}
+
+static int qg_full_uah(struct qg_lite *qg)
+{
+	return qg->learned_uah ? qg->learned_uah : qg_design_uah(qg);
+}
+
+/* capacity the previous OS learned; trusted only between 50 % and 110 % of design */
+static void qg_read_learned(struct qg_lite *qg)
+{
+	u8 buf[2];
+	int uah;
+
+	if (!qg->has_sdam ||
+	    regmap_bulk_read(qg->regmap, qg->sdam_base + SDAM_LEARNED_CAP, buf, 2))
+		return;
+	uah = (buf[0] | (buf[1] << 8)) * 1000;
+	if (uah >= qg_design_uah(qg) / 2 && uah <= qg_design_uah(qg) * 11 / 10)
+		qg->learned_uah = uah;
+}
+
+static int qg_ocv_soc_x100(struct qg_lite *qg, int v_uv, int i_ua, int temp_dc)
+{
+	int rbat = qg->info->factory_internal_resistance_uohm > 0 ?
+		   qg->info->factory_internal_resistance_uohm : QG_DEFAULT_RBAT_UOHM;
+	int cap;
+
+	qg->ocv_uv = v_uv + (int)div_s64((s64)i_ua * rbat, 1000000);
+	cap = power_supply_batinfo_ocv2cap(qg->info, qg->ocv_uv, temp_dc / 10);
+	if (cap < 0)
+		return -EINVAL;
+	return clamp(cap, 0, 100) * 100;
+}
+
+/*
+ * With a charger described by "power-supplies", its status is used while it is
+ * online: it comes from the charger's state machine (pre/fast/taper charge,
+ * terminated, inhibited), which does not flip when the phone's load briefly
+ * exceeds a weak input limit and the battery current changes sign.
+ */
+static int qg_charger_status(struct qg_lite *qg)
+{
+	union power_supply_propval val;
+
+	if (!qg->chg_psy && !qg->no_chg_psy) {
+		struct power_supply *psy =
+			devm_power_supply_get_by_reference(qg->dev, "power-supplies");
+
+		if (IS_ERR(psy))
+			qg->no_chg_psy = true;	/* not described: no charger lookup */
+		else
+			qg->chg_psy = psy;	/* NULL: not registered yet, retry */
+	}
+	if (!qg->chg_psy)
+		return -ENODEV;
+
+	if (power_supply_get_property(qg->chg_psy, POWER_SUPPLY_PROP_ONLINE, &val))
+		return -EIO;
+	if (!val.intval)
+		return POWER_SUPPLY_STATUS_DISCHARGING;
+	if (power_supply_get_property(qg->chg_psy, POWER_SUPPLY_PROP_STATUS, &val))
+		return -EIO;
+	if (val.intval == POWER_SUPPLY_STATUS_NOT_CHARGING && qg->soc_reported >= 99)
+		return POWER_SUPPLY_STATUS_FULL;
+	if (val.intval == POWER_SUPPLY_STATUS_UNKNOWN ||
+	    val.intval == POWER_SUPPLY_STATUS_DISCHARGING)
+		return -EIO;
+	return val.intval;
+}
+
+/*
+ * Without a charger driver: guess from the current. Near full on USB the
+ * charger tapers or inhibits and the battery current wanders around zero in
+ * both directions, so "full" tolerates +-200 mA.
+ */
+static int qg_status_now(struct qg_lite *qg)
+{
+	int online, i = qg->ibat_ua;
+	int chg = qg_charger_status(qg);
+
+	if (chg >= 0)
+		return chg;
+
+	online = qg_usbin_online(qg);
+
+	if (online > 0 && qg->soc_reported >= 99 && abs(i) <= 200000)
+		return POWER_SUPPLY_STATUS_FULL;
+	if (i < -QG_STATUS_CURRENT_UA)
+		return POWER_SUPPLY_STATUS_CHARGING;
+	if (i > QG_STATUS_CURRENT_UA || online <= 0)
+		return POWER_SUPPLY_STATUS_DISCHARGING;
+	return POWER_SUPPLY_STATUS_NOT_CHARGING;
+}
+
+/* a new status must be seen on two polls in a row before it is reported */
+static int qg_status(struct qg_lite *qg)
+{
+	int now = qg_status_now(qg);
+
+	if (now == qg->status || now == qg->status_cand) {
+		qg->status_cand = now;
+		return now;
+	}
+	qg->status_cand = now;
+	return qg->status;
+}
+
+static void qg_update(struct qg_lite *qg)
+{
+	int v, i, ocv_soc, target, old_soc, old_status, full = qg_full_uah(qg);
+	ktime_t now = ktime_get_boottime();
+	s64 dt_ms;
+
+	if (qg_read_vi(qg, &v, &i))
+		return;
+
+	mutex_lock(&qg->lock);
+	old_soc = qg->soc_reported;
+	old_status = qg->status;
+
+	dt_ms = ktime_ms_delta(now, qg->last);
+	qg->last = now;
+	qg->vbat_uv = v;
+	qg->ibat_ua = i;
+	qg->temp_dc = qg_temp_dc(qg);
+
+	/* coulomb counting: nAh = uA * ms / 3600 */
+	qg->charge_nah -= div_s64((s64)i * dt_ms, 3600);
+	qg->charge_nah = clamp_t(s64, qg->charge_nah, 0, (s64)full * 1000);
+	qg->soc_x100 = div_s64(qg->charge_nah * 10, full);
+
+	/* pull toward the OCV estimate, strongly only when it is trustworthy */
+	ocv_soc = qg_ocv_soc_x100(qg, v, i, qg->temp_dc);
+	if (ocv_soc >= 0) {
+		int div = abs(i) < QG_REST_CURRENT_UA ? 20 : 200;
+
+		qg->soc_x100 += (ocv_soc - qg->soc_x100) / div;
+	}
+
+	/* end points */
+	if (i < 0 && abs(i) < 150000 && qg_usbin_online(qg) > 0 &&
+	    v >= qg->info->voltage_max_design_uv - 30000 &&
+	    qg->info->voltage_max_design_uv > 0)
+		qg->soc_x100 = 10000;
+	if (qg->info->voltage_min_design_uv > 0 &&
+	    v < qg->info->voltage_min_design_uv)
+		qg->soc_x100 = 0;
+
+	qg->soc_x100 = clamp(qg->soc_x100, 0, 10000);
+	qg->charge_nah = div_s64((s64)qg->soc_x100 * full, 10);
+
+	/* reported value only moves in the direction the current flows */
+	target = DIV_ROUND_CLOSEST(qg->soc_x100, 100);
+	if (i > QG_DIR_CURRENT_UA)
+		target = min(target, qg->soc_reported);
+	else if (i < -QG_DIR_CURRENT_UA)
+		target = max(target, qg->soc_reported);
+	qg->soc_reported = target;
+	qg->status = qg_status(qg);
+	if (target != old_soc && qg->has_sdam)
+		regmap_write(qg->regmap, qg->sdam_base + SDAM_SOC, target);
+	mutex_unlock(&qg->lock);
+
+	if (target != old_soc || qg->status != old_status)
+		power_supply_changed(qg->psy);
+}
+
+static void qg_work(struct work_struct *work)
+{
+	struct qg_lite *qg = container_of(work, struct qg_lite, work.work);
+
+	qg_update(qg);
+	schedule_delayed_work(&qg->work, msecs_to_jiffies(QG_POLL_MS));
+}
+
+static void qg_init_soc(struct qg_lite *qg)
+{
+	int v, i, ocv_soc, soc = -1;
+	unsigned int valid = 0, sdam_soc = 0;
+
+	if (qg_read_vi(qg, &v, &i)) {
+		v = qg->info->voltage_max_design_uv;
+		i = 0;
+	}
+	qg->temp_dc = qg_temp_dc(qg);
+	ocv_soc = qg_ocv_soc_x100(qg, v, i, qg->temp_dc);
+
+	if (qg->has_sdam &&
+	    !regmap_read(qg->regmap, qg->sdam_base + SDAM_VALID, &valid) &&
+	    !regmap_read(qg->regmap, qg->sdam_base + SDAM_SOC, &sdam_soc) &&
+	    (valid & BIT(0)) && sdam_soc <= 100)
+		soc = sdam_soc * 100;
+
+	/* a stale saved value (the battery changed while off) loses to the OCV */
+	if (soc < 0 || (ocv_soc >= 0 && abs(soc - ocv_soc) > 1000))
+		soc = ocv_soc >= 0 ? ocv_soc : 5000;
+
+	dev_info(qg->dev, "vbat %d uV ibat %d uA, start SOC %d%% (sdam %s, ocv %d%%)\n",
+		 v, -i, soc / 100, soc == (int)sdam_soc * 100 ? "used" : "ignored",
+		 ocv_soc / 100);
+
+	qg->vbat_uv = v;
+	qg->ibat_ua = i;
+	qg->soc_x100 = soc;
+	qg->soc_reported = DIV_ROUND_CLOSEST(soc, 100);
+	qg->charge_nah = div_s64((s64)soc * qg_full_uah(qg), 10);
+	qg->last = ktime_get_boottime();
+	qg->status = qg_status_now(qg);
+	qg->status_cand = qg->status;
+	qg->ready = true;
+}
+
+static const enum power_supply_property qg_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+};
+
+static int qg_get_property(struct power_supply *psy,
+			   enum power_supply_property psp,
+			   union power_supply_propval *val)
+{
+	struct qg_lite *qg = power_supply_get_drvdata(psy);
+	unsigned int sts;
+	int ret = 0;
+
+	if (psp == POWER_SUPPLY_PROP_PRESENT) {
+		ret = regmap_read(qg->regmap, qg->base + QG_STATUS1, &sts);
+		if (!ret)
+			val->intval = !!(sts & QG_STATUS1_BATT_PRESENT);
+		return ret;
+	}
+	if (psp == POWER_SUPPLY_PROP_TECHNOLOGY) {
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	}
+
+	mutex_lock(&qg->lock);
+	if (!qg->ready) {
+		mutex_unlock(&qg->lock);
+		return -EAGAIN;
+	}
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = qg->status;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = qg->soc_reported;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = qg->vbat_uv;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		val->intval = qg->ocv_uv;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		/* power_supply ABI: negative while discharging */
+		val->intval = -qg->ibat_ua;
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		val->intval = qg->temp_dc;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = qg_design_uah(qg);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		val->intval = qg_full_uah(qg);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		val->intval = div_s64(qg->charge_nah, 1000);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = qg->info->voltage_max_design_uv;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = qg->info->voltage_min_design_uv;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&qg->lock);
+	return ret;
+}
+
+static const struct power_supply_desc qg_desc = {
+	.name = "qcom-battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = qg_props,
+	.num_properties = ARRAY_SIZE(qg_props),
+	.get_property = qg_get_property,
+};
+
+static struct iio_channel *qg_get_iio(struct device *dev, const char *name)
+{
+	struct iio_channel *chan = devm_iio_channel_get(dev, name);
+
+	if (IS_ERR(chan) && PTR_ERR(chan) != -EPROBE_DEFER)
+		return NULL;	/* optional */
+	return chan;
+}
+
+static int qg_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct power_supply_config cfg = {};
+	struct qg_lite *qg;
+	unsigned int subtype, sts;
+	u32 regs[2];
+	int ret, n;
+
+	qg = devm_kzalloc(dev, sizeof(*qg), GFP_KERNEL);
+	if (!qg)
+		return -ENOMEM;
+	qg->dev = dev;
+	mutex_init(&qg->lock);
+
+	qg->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!qg->regmap)
+		return dev_err_probe(dev, -ENODEV, "no parent regmap\n");
+
+	n = of_property_count_u32_elems(dev->of_node, "reg");
+	if (n < 1 || of_property_read_u32_array(dev->of_node, "reg", regs, min(n, 2)))
+		return dev_err_probe(dev, -EINVAL, "bad reg property\n");
+	qg->base = regs[0];
+	if (n >= 2) {
+		qg->sdam_base = regs[1];
+		qg->has_sdam = true;
+	}
+
+	ret = regmap_read(qg->regmap, qg->base + QG_PERPH_SUBTYPE, &subtype);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot read subtype\n");
+	qg->i_scale = subtype == QG_SUBTYPE_IBAT_5A ? QG_I_UA_PER_LSB_X1000_5A :
+						      QG_I_UA_PER_LSB_X1000_10A;
+
+	ret = regmap_read(qg->regmap, qg->base + QG_STATUS1, &sts);
+	if (ret)
+		return ret;
+	if (!(sts & QG_STATUS1_OK))
+		dev_warn(dev, "QG not marked OK by the bootloader (status1 %#x)\n", sts);
+
+	qg->temp_chan = qg_get_iio(dev, "batt_therm");
+	if (IS_ERR(qg->temp_chan))
+		return PTR_ERR(qg->temp_chan);
+	qg->usbin_chan = qg_get_iio(dev, "usb_in_v");
+	if (IS_ERR(qg->usbin_chan))
+		return PTR_ERR(qg->usbin_chan);
+
+	cfg.drv_data = qg;
+	cfg.fwnode = dev_fwnode(dev);
+	qg->psy = devm_power_supply_register(dev, &qg_desc, &cfg);
+	if (IS_ERR(qg->psy))
+		return dev_err_probe(dev, PTR_ERR(qg->psy), "cannot register\n");
+
+	ret = power_supply_get_battery_info(qg->psy, &qg->info);
+	if (ret)
+		return dev_err_probe(dev, ret, "no monitored-battery info\n");
+	if (!qg->info->ocv_table[0])
+		return dev_err_probe(dev, -EINVAL, "monitored-battery has no OCV table\n");
+
+	mutex_lock(&qg->lock);
+	qg_read_learned(qg);
+	qg_init_soc(qg);
+	mutex_unlock(&qg->lock);
+	power_supply_changed(qg->psy);
+
+	ret = devm_delayed_work_autocancel(dev, &qg->work, qg_work);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&qg->work, msecs_to_jiffies(QG_POLL_MS));
+	return 0;
+}
+
+static const struct of_device_id qg_of_match[] = {
+	{ .compatible = "qcom,pm6150-qg" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, qg_of_match);
+
+static struct platform_driver qg_driver = {
+	.probe = qg_probe,
+	.driver = {
+		.name = "qcom-qg-lite",
+		.of_match_table = qg_of_match,
+	},
+};
+module_platform_driver(qg_driver);
+
+MODULE_DESCRIPTION("Read-only Qualcomm QGauge battery driver");
+MODULE_IMPORT_NS("IIO_CONSUMER");
+MODULE_LICENSE("GPL");
