+&pm6150_lsid0 {
+	/*
+	 * QGauge (fuel gauge) and its SDAM. Driven read-only by qcom_qg_lite (patch 0010): the bootloader
+	 * leaves it measuring; SDAM holds the last saved SOC (0x47) and the learned capacity (0x68).
+	 */
+	qgauge@4800 {
+		compatible = "qcom,pm6150-qg";
+		reg = <0x4800>, <0xb600>;
+		io-channels = <&pm6150_adc ADC5_BAT_THERM_100K_PU>,
+			      <&pm6150_adc ADC5_USB_IN_V_16>;
+		io-channel-names = "batt_therm", "usb_in_v";
+		monitored-battery = <&battery>;
+		power-supplies = <&pm6150_charger>;	/* status comes from the charger while plugged in */
+	};
+
+	/*
+	 * SMB5 charger (patch 0008). The module is blacklisted in /etc/modprobe.d until it is tested by
+	 * hand: it reprograms the input current limit and charging enable.
+	 */
+	pm6150_charger: charger@1000 {
+		compatible = "qcom,pm8150b-charger";
+		reg = <0x1000>;
+
+		interrupts = <0x0 0x13 0x4 IRQ_TYPE_EDGE_BOTH>,
+			     <0x0 0x12 0x2 IRQ_TYPE_EDGE_BOTH>,
+			     <0x0 0x16 0x1 IRQ_TYPE_EDGE_RISING>,
+			     <0x0 0x13 0x7 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "usbin-plugin", "bat-ov", "wdog-bark", "usbin-icl-change";
+
+		io-channels = <&pm6150_adc ADC5_USB_IN_I>,
+			      <&pm6150_adc ADC5_USB_IN_V_16>;
+		io-channel-names = "usb_in_i_uv", "usb_in_v_div_16";
+
+		monitored-battery = <&battery>;
+	};
+};
