@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __QRTRCAP_H
+#define __QRTRCAP_H
+#include <linux/types.h>
+struct sk_buff;
+#define QRTRCAP_RX    0		/* from a remote node (modem, DSPs) */
+#define QRTRCAP_TX    1		/* to a remote node */
+#define QRTRCAP_LOCAL 2		/* between two sockets on this CPU */
+void qrtrcap_init(void);
+void qrtrcap_raw(u32 dir, const void *data, size_t len);
+void qrtrcap_skb(u32 dir, const void *hdr, size_t hdrlen, const struct sk_buff *skb);
+#endif
