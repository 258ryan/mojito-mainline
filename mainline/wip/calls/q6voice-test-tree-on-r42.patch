+struct avcs_cmd_map {
+	struct apr_hdr hdr;
+	uint16_t mem_pool_id;
+	uint16_t num_regions;
+	uint32_t property_flag;
+	uint32_t addr_lsw;
+	uint32_t addr_msw;
+	uint32_t size;
+} __packed;
+
+struct avcs_cmd_register {
+	struct apr_hdr hdr;
+	uint32_t addr_lsw;
+	uint32_t addr_msw;
+	uint32_t handle;
