@@ -45,6 +52,183 @@ module_param(device_unmute, bool, 0644);
 static int volume_step = -1;	/* -1: do not set (rejected without calibration data) */
 module_param(volume_step, int, 0644);
 
+/*
+ * TEST: calibration tables for the call, generated by the phone's owner from the stock database (files in /lib/firmware,
+ * never part of any repository) and registered with the voice services as the vendor driver does.
+ */
+static bool calibrate = true;
+module_param(calibrate, bool, 0644);
+
+#define VSS_IMEMORY_CMD_MAP_PHYSICAL			0x00011334
+#define VSS_IMEMORY_CMD_UNMAP				0x00011337
+#define VSS_ISTREAM_CMD_REGISTER_CALIBRATION_DATA_V2	0x00011369
+#define VSS_ISTREAM_CMD_REGISTER_STATIC_CALIBRATION_DATA 0x0001307D /* not accepted here */
+#define VSS_IVOCPROC_CMD_REGISTER_DEVICE_CONFIG		0x00011371
+#define VSS_IVOCPROC_CMD_REGISTER_CALIBRATION_DATA_V2	0x00011373
+#define VSS_IVOCPROC_CMD_REGISTER_VOL_CALIBRATION_DATA	0x00011374
+#define VSS_IVOCPROC_CMD_REGISTER_STATIC_CALIBRATION_DATA 0x00013079
+#define VSS_IVOCPROC_CMD_REGISTER_DYNAMIC_CALIBRATION_DATA 0x0001307B
+#define CAL_COLUMNS	324
+#define CAL_SIZE	SZ_128K
+
+struct vss_map_physical_cmd {
+	struct apr_hdr hdr;
+	u32 table_lsw, table_msw, table_size;
+	u8 is_cached;
+	u16 cache_line_size;
+	u32 access_mask;
+	u32 page_align;
+	u8 min_data_width;
+	u8 max_data_width;
+} __packed;
+
+struct vss_unmap_cmd {
+	struct apr_hdr hdr;
+	u32 handle;
+} __packed;
+
+struct vss_register_cmd {
+	struct apr_hdr hdr;
+	u32 handle, addr_lsw, addr_msw, size;
+	u8 columns[CAL_COLUMNS];	/* not sent with the device configuration */
+} __packed;
+
+struct q6voice_cal {
+	struct device *dma_dev;
+	void *buf;
+	dma_addr_t dma;
+	u64 phys;
+	u32 handle;
+};
+
+static int q6voice_cal_one(struct device *dev, struct q6voice_cal *cal, struct q6voice_session *s, const char *name,
+			   u32 opcode, size_t offset, const struct firmware *columns)
+{
+	struct vss_register_cmd *cmd;
+	const struct firmware *fw;
+	int ret;
+
+	ret = request_firmware(&fw, name, dev);
+	if (ret)
+		return ret;
+	if (offset + fw->size > CAL_SIZE) {
+		release_firmware(fw);
+		return -E2BIG;
+	}
+	memcpy(cal->buf + offset, fw->data, fw->size);
+
+	cmd = kzalloc(sizeof(*cmd), GFP_KERNEL);
+	if (!cmd) {
+		release_firmware(fw);
+		return -ENOMEM;
+	}
+	cmd->hdr.opcode = opcode;
+	cmd->hdr.pkt_size = columns ? sizeof(*cmd) : offsetof(struct vss_register_cmd, columns);
+	cmd->handle = cal->handle;
+	cmd->addr_lsw = lower_32_bits(cal->phys + offset);
+	cmd->addr_msw = upper_32_bits(cal->phys + offset);
+	cmd->size = fw->size;
+	if (columns)
+		memcpy(cmd->columns, columns->data, min_t(size_t, columns->size, CAL_COLUMNS));
+	ret = q6voice_common_send(s, &cmd->hdr);
+	dev_info(dev, "calibration %s (%zu bytes, command %#x): %d\n", name, fw->size, opcode, ret);
+	kfree(cmd);
+	release_firmware(fw);
+	return ret;
+}
+
+struct q6voice_cal *q6voice_cal_register(struct device *dev, struct q6voice_session *mvm, struct q6voice_session *cvs,
+					 struct q6voice_session *cvp)
+{
+	struct vss_map_physical_cmd map = {};
+	const struct firmware *columns;
+	struct platform_device *pdev = NULL;
+	struct of_phandle_args args;
+	struct device_node *np;
+	struct q6voice_cal *cal;
+	u32 *table;
+	int ret;
+
+	if (!calibrate || request_firmware(&columns, "mojito-voice-columns.bin", dev))
+		return NULL;
+	cal = kzalloc(sizeof(*cal), GFP_KERNEL);
+	if (!cal)
+		goto out;
+
+	/* TEST shortcut: memory mapped through the ASM DAI device's SMMU stream */
+	np = of_find_compatible_node(NULL, NULL, "qcom,q6asm-dais");
+	if (np)
+		pdev = of_find_device_by_node(np);
+	if (!pdev || of_parse_phandle_with_fixed_args(np, "iommus", 1, 0, &args))
+		goto fail;
+	of_node_put(args.np);
+	cal->dma_dev = &pdev->dev;
+	cal->buf = dma_alloc_coherent(cal->dma_dev, CAL_SIZE, &cal->dma, GFP_KERNEL);
+	if (!cal->buf)
+		goto fail;
+	cal->phys = cal->dma | ((u64)(args.args[0] & 0xf) << 32);
+
+	/* the first page: the table describing the block that follows it */
+	table = cal->buf;
+	table[3] = lower_32_bits(cal->phys + SZ_4K);
+	table[4] = upper_32_bits(cal->phys + SZ_4K);
+	table[5] = CAL_SIZE - SZ_4K;
+	map.hdr.opcode = VSS_IMEMORY_CMD_MAP_PHYSICAL;
+	map.hdr.pkt_size = sizeof(map);
+	map.table_lsw = lower_32_bits(cal->phys);
+	map.table_msw = upper_32_bits(cal->phys);
+	map.table_size = 24;	/* the next-table descriptor (12 bytes) and one block (12) */
+	map.is_cached = 1;
+	map.cache_line_size = 128;
+	map.access_mask = 3;
+	map.page_align = SZ_4K;
+	map.min_data_width = 8;
+	map.max_data_width = 64;
+	mvm->map_handle = 0;
+	ret = q6voice_common_send(mvm, &map.hdr);
+	dev_info(dev, "calibration memory map: %d, handle %#x\n", ret, mvm->map_handle);
+	if (ret || !mvm->map_handle)
+		goto free;
+	cal->handle = mvm->map_handle;
+
+	if (cvs)
+		q6voice_cal_one(dev, cal, cvs, "mojito-voice-stream.bin",
+				VSS_ISTREAM_CMD_REGISTER_CALIBRATION_DATA_V2, SZ_4K, columns);
+	q6voice_cal_one(dev, cal, cvp, "mojito-voice-devcfg.bin", VSS_IVOCPROC_CMD_REGISTER_DEVICE_CONFIG, SZ_8K, NULL);
+	q6voice_cal_one(dev, cal, cvp, "mojito-voice-static.bin",
+			VSS_IVOCPROC_CMD_REGISTER_CALIBRATION_DATA_V2, SZ_16K, columns);
+	q6voice_cal_one(dev, cal, cvp, "mojito-voice-volume.bin",
+			/* the stock "dynamic" table: only this command takes it (CVD 2.4) */
+			VSS_IVOCPROC_CMD_REGISTER_DYNAMIC_CALIBRATION_DATA, SZ_32K, columns);
+	goto out;
+free:
+	dma_free_coherent(cal->dma_dev, CAL_SIZE, cal->buf, cal->dma);
+fail:
+	if (pdev)
+		put_device(&pdev->dev);
+	kfree(cal);
+	cal = NULL;
+out:
+	release_firmware(columns);
+	return cal;
+}
+
+void q6voice_cal_release(struct q6voice_cal *cal, struct q6voice_session *mvm)
+{
+	struct vss_unmap_cmd unmap = {};
+
+	if (!cal)
+		return;
+	unmap.hdr.opcode = VSS_IMEMORY_CMD_UNMAP;
+	unmap.hdr.pkt_size = sizeof(unmap);
+	unmap.handle = cal->handle;
+	if (mvm)
+		q6voice_common_send(mvm, &unmap.hdr);
+	dma_free_coherent(cal->dma_dev, CAL_SIZE, cal->buf, cal->dma);
+	put_device(cal->dma_dev);
+	kfree(cal);
+}
