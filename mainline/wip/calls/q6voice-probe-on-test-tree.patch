+/* TEST: start (1) or stop (0) the level probe on the running voice call: echo 1 > .../parameters/probe_now */
+static struct q6voice *q6voice_test_v;
+
+static int q6voice_probe_now_set(const char *val, const struct kernel_param *kp)
+{
+	struct q6voice *v = q6voice_test_v;
+	struct q6voice_path *p;
+	struct q6voice_session *cvp;
+	bool on;
+	int ret = kstrtobool(val, &on);
+
+	if (ret)
+		return ret;
+	if (!v)
+		return -ENODEV;
+	p = &v->paths[Q6VOICE_PATH_VOICE];
+	mutex_lock(&p->lock);
+	if (!p->runtime || p->runtime->started != 3 || !p->runtime->cal) {
+		ret = -ENOENT;
+		goto out;
+	}
+	cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	q6voice_vpcm_stop(v->dev, p->runtime->cal, cvp);
+	if (on)
+		q6voice_vpcm_start(v->dev, p->runtime->cal, cvp);
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static const struct kernel_param_ops q6voice_probe_now_ops = {
+	.set = q6voice_probe_now_set,
+};
+module_param_cb(probe_now, &q6voice_probe_now_ops, NULL, 0200);
+
+/* TEST: tear the running voice path down and build it again: echo 1 > .../parameters/restart_now */
+static int q6voice_restart_now_set(const char *val, const struct kernel_param *kp)
+{
+	struct q6voice *v = q6voice_test_v;
+	struct q6voice_path *p;
+	int ret = 0;
+
+	if (!v)
+		return -ENODEV;
+	p = &v->paths[Q6VOICE_PATH_VOICE];
+	mutex_lock(&p->lock);
+	if (!p->runtime || p->runtime->started != 3) {
+		ret = -ENOENT;
+		goto out;
+	}
+	q6voice_path_stop(p);
+	q6voice_path_destroy(p);
+	p->runtime = kzalloc(sizeof(*p->runtime), GFP_KERNEL);
+	if (!p->runtime) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	p->runtime->started = 3;
+	ret = q6voice_path_start(p);
+	dev_info(v->dev, "voice path restarted: %d\n", ret);
+	if (ret)
+		p->runtime->started = 0;
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static const struct kernel_param_ops q6voice_restart_now_ops = {
+	.set = q6voice_restart_now_set,
+};
+module_param_cb(restart_now, &q6voice_restart_now_ops, NULL, 0200);
