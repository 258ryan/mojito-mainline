+/* send without waiting for the reply (usable from the callback) */
+int q6voice_common_post(struct q6voice_session *s, struct apr_hdr *hdr)
+{
+	int ret;
+
+	hdr->hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+				       APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	hdr->src_port = s->port;
+	hdr->dest_port = s->handle;
+	hdr->token = 0;
+
+	ret = apr_send_pkt(s->svc->adev, (struct apr_pkt *)hdr);
+	return ret < 0 ? ret : 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_common_post);
