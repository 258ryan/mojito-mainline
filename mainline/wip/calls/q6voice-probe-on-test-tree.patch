+/*
+ * TEST: host PCM taps (VSS_IVPCM) as level meters. The DSP copies 20 ms frames of the default TX and RX tap points into
+ * the calibration block (after the tables); only peak and RMS levels are logged, no audio is kept.
+ */
+static bool pcm_probe;
+module_param(pcm_probe, bool, 0644);
+static uint pcm_rate = 16000;	/* 0: automatic */
+module_param(pcm_rate, uint, 0644);
+static uint pcm_taps = 3;	/* bit 0: TX tap, bit 1: RX tap */
+module_param(pcm_taps, uint, 0644);
+
+#define VSS_IVPCM_CMD_START_V2			0x00011339
+#define VSS_IVPCM_CMD_STOP			0x0001100B
+#define VSS_IVPCM_EVT_PUSH_BUFFER_V2		0x0001133A
+#define VSS_IVPCM_EVT_NOTIFY_V2			0x0001133B
+#define VSS_IVPCM_TAP_POINT_TX_DEFAULT		0x00011289
+#define VSS_IVPCM_TAP_POINT_RX_DEFAULT		0x0001128A
+#define VSS_IVPCM_TAP_POINT_DIR_OUT		0
+#define VSS_IVPCM_NOTIFY_MASK_OUTPUT_BUFFER	1
+#define VSS_IVPCM_NOTIFY_MASK_TIMETICK		4
+#define VSS_IVPCM_PUSH_BUFFER_MASK_OUTPUT_BUFFER 1
+#define PCM_OFFSET	SZ_64K
+#define PCM_BUF		SZ_8K
+
+struct vss_vpcm_tap_point {
+	u32 tap_point;
+	u16 direction;
+	u16 sampling_rate;
+	u16 duration;
+} __packed;
+
+struct vss_vpcm_start_cmd {
+	struct apr_hdr hdr;
+	u32 mem_handle;
+	u32 num_tap_points;
+	struct vss_vpcm_tap_point tap_points[2];
+} __packed;
+
+struct vss_vpcm_notify {
+	u32 tap_point;
+	u32 notify_mask;
+	u64 out_buf_addr;
+	u64 in_buf_addr;
+	u16 filled_out_size;
+	u16 request_buf_size;
+	u16 sampling_rate;
+	u16 num_out_channels;
+} __packed;
+
+struct vss_vpcm_push_cmd {
+	struct apr_hdr hdr;
+	u32 tap_point;
+	u32 push_buf_mask;
+	u64 out_buf_mem_address;
+	u16 out_buf_mem_size;
+	u64 in_buf_mem_address;
+	u16 in_buf_mem_size;
+	u16 sampling_rate;
+	u16 num_in_channels;
+} __packed;
+
+struct q6voice_vpcm_stats {
+	unsigned int events, frames, errors, samples;
+	unsigned int peak, total_peak;
+	u64 sumsq;
+};
+
 struct q6voice_cal {
 	struct device *dma_dev;
 	void *buf;
 	dma_addr_t dma;
 	u64 phys;
 	u32 handle;
+	struct q6voice_vpcm_stats st[2];	/* 0: TX, 1: RX */
 };
 
+static const char *const vpcm_tap_name[2] = { "TX (mic)", "RX (downlink)" };
+
+static void q6voice_vpcm_event(struct q6voice_session *s, const struct apr_resp_pkt *data, void *priv)
+{
+	struct q6voice_cal *cal = priv;
+	const struct vss_vpcm_notify *n = data->payload;
+	struct vss_vpcm_push_cmd push = {};
+	struct q6voice_vpcm_stats *st;
+	size_t off;
+	int i;
+
+	if (data->hdr.opcode != VSS_IVPCM_EVT_NOTIFY_V2 || data->payload_size < sizeof(*n))
+		return;
+	if (n->tap_point == VSS_IVPCM_TAP_POINT_TX_DEFAULT)
+		i = 0;
+	else if (n->tap_point == VSS_IVPCM_TAP_POINT_RX_DEFAULT)
+		i = 1;
+	else
+		return;
+	st = &cal->st[i];
+	off = PCM_OFFSET + i * PCM_BUF;
+
+	if (!st->events++)
+		dev_info(s->dev, "vpcm %s: first event mask %#x, request %u bytes, rate %u, channels %u\n",
+			 vpcm_tap_name[i], n->notify_mask, n->request_buf_size, n->sampling_rate,
+			 n->num_out_channels);
+	if (!(n->notify_mask & VSS_IVPCM_NOTIFY_MASK_TIMETICK)) {
+		if (!st->errors++)
+			dev_info(s->dev, "vpcm %s: error notification, mask %#x\n", vpcm_tap_name[i], n->notify_mask);
+		return;
+	}
+
+	if (n->notify_mask & VSS_IVPCM_NOTIFY_MASK_OUTPUT_BUFFER) {
+		const s16 *pcm = cal->buf + off;
+		unsigned int k, count = min_t(unsigned int, n->filled_out_size, PCM_BUF) / 2;
+
+		for (k = 0; k < count; k++) {
+			unsigned int a = abs(pcm[k]);
+
+			st->peak = max(st->peak, a);
+			st->sumsq += a * a;
+		}
+		st->samples += count;
+		st->total_peak = max(st->total_peak, st->peak);
+		if (++st->frames % 50 == 0) {	/* about once a second */
+			dev_info(s->dev, "vpcm %s: frames %u, peak %u, rms %u (of 32767), rate %u, errors %u\n",
+				 vpcm_tap_name[i], st->frames, st->peak,
+				 st->samples ? (u32)int_sqrt64(st->sumsq / st->samples) : 0, n->sampling_rate,
+				 st->errors);
+			st->peak = 0;
+			st->sumsq = 0;
+			st->samples = 0;
+		}
+	}
+
+	push.hdr.opcode = VSS_IVPCM_EVT_PUSH_BUFFER_V2;
+	push.hdr.pkt_size = sizeof(push);
+	push.tap_point = n->tap_point;
+	push.push_buf_mask = VSS_IVPCM_PUSH_BUFFER_MASK_OUTPUT_BUFFER;
+	push.out_buf_mem_address = cal->phys + off;
+	push.out_buf_mem_size = min_t(unsigned int, ALIGN(n->request_buf_size, 128), PCM_BUF);
+	push.sampling_rate = n->sampling_rate;
+	push.num_in_channels = 1;
+	q6voice_common_post(s, &push.hdr);
+}
+
+static void q6voice_vpcm_start(struct device *dev, struct q6voice_cal *cal, struct q6voice_session *cvp)
+{
+	struct vss_vpcm_start_cmd cmd = {};
+	int ret, i;
+
+	memset(cal->st, 0, sizeof(cal->st));
+	memset(cal->buf + PCM_OFFSET, 0, 2 * PCM_BUF);
+	cvp->event_priv = cal;
+	cvp->event = q6voice_vpcm_event;
+
+	cmd.hdr.opcode = VSS_IVPCM_CMD_START_V2;
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.mem_handle = cal->handle;
+	for (i = 0; i < 2; i++) {
+		struct vss_vpcm_tap_point *tp = &cmd.tap_points[cmd.num_tap_points];
+
+		if (!(pcm_taps & BIT(i)))
+			continue;
+		tp->tap_point = i ? VSS_IVPCM_TAP_POINT_RX_DEFAULT : VSS_IVPCM_TAP_POINT_TX_DEFAULT;
+		tp->direction = VSS_IVPCM_TAP_POINT_DIR_OUT;
+		tp->sampling_rate = pcm_rate;
+		cmd.num_tap_points++;
+	}
+	cmd.hdr.pkt_size = offsetof(struct vss_vpcm_start_cmd, tap_points) +
+			   cmd.num_tap_points * sizeof(struct vss_vpcm_tap_point);
+	ret = q6voice_common_send(cvp, &cmd.hdr);
+	dev_info(dev, "vpcm start (rate %u, taps %#x): %d\n", pcm_rate, pcm_taps, ret);
+	if (ret)
+		cvp->event = NULL;
+}
+
+static void q6voice_vpcm_stop(struct device *dev, struct q6voice_cal *cal, struct q6voice_session *cvp)
+{
+	struct apr_pkt cmd = {};
+	int ret, i;
+
+	if (!cal || !cvp->event)
+		return;
+	cmd.hdr.opcode = VSS_IVPCM_CMD_STOP;
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	ret = q6voice_common_send(cvp, &cmd.hdr);
+	cvp->event = NULL;
+	for (i = 0; i < 2; i++)
+		dev_info(dev, "vpcm %s: stop %d; events %u, frames %u, errors %u, loudest %u\n", vpcm_tap_name[i], ret,
+			 cal->st[i].events, cal->st[i].frames, cal->st[i].errors, cal->st[i].total_peak);
+}
