From: postmarketOS mojito port
Subject: [PATCH] ASoC: codecs: wcd937x: count every user of the RX clock

wcd937x_rx_clk_enable() returned early for a second user without taking a
reference, while wcd937x_rx_clk_disable() runs once per RX path and gates the
clock and bias on the first call. On the Redmi Note 10 the RX clock and bias
bits were seen cleared during playback ("clk already disabled" in the log).
Take one reference per user and touch the hardware on the first and last one.
---
--- a/sound/soc/codecs/wcd937x.c	2026-11-27 06:59:42.047016269 +0500
+++ b/sound/soc/codecs/wcd937x.c	2026-11-27 06:59:42.217147268 +0500
@@ -301,7 +301,8 @@
 {
 	struct wcd937x_priv *wcd937x = snd_soc_component_get_drvdata(component);
 
-	if (atomic_read(&wcd937x->rx_clk_cnt))
+	/* one reference per user, program the hardware for the first one only */
+	if (atomic_inc_return(&wcd937x->rx_clk_cnt) > 1)
 		return 0;
 
 	snd_soc_component_update_bits(component, WCD937X_DIGITAL_CDC_DIG_CLK_CTL, BIT(3), BIT(3));
@@ -312,8 +313,6 @@
 	snd_soc_component_update_bits(component, WCD937X_DIGITAL_CDC_RX2_CTL, BIT(6), 0x00);
 	snd_soc_component_update_bits(component, WCD937X_DIGITAL_CDC_ANA_CLK_CTL, BIT(1), BIT(1));
 
-	atomic_inc(&wcd937x->rx_clk_cnt);
-
 	return 0;
 }
 
@@ -326,7 +325,9 @@
 		return 0;
 	}
 
-	atomic_dec(&wcd937x->rx_clk_cnt);
+	/* keep the clock and bias while another path still uses them */
+	if (atomic_dec_return(&wcd937x->rx_clk_cnt))
+		return 0;
 
 	snd_soc_component_update_bits(component, WCD937X_ANA_RX_SUPPLIES, BIT(0), 0x00);
 	snd_soc_component_update_bits(component, WCD937X_DIGITAL_CDC_ANA_CLK_CTL, BIT(1), 0x00);
