From: postmarketOS mojito port
Subject: [PATCH] ASoC: codecs: add an AW87xxx amplifier driven by a register sequence

The Redmi Note 10 speaker/earpiece amplifiers (Awinic AW87xxx, ids 0x59/0x5a on i2c3) are
configured by opaque vendor tables. Write the stock table from the DT when DAPM powers the
amplifier up (with an optional reset GPIO), switch it off on power down, and expose a DAPM
switch so UCM can pick the amplifiers. Tested by hand with i2c-tools first: speaker plays.
---
diff -urN a/sound/soc/codecs/aw87xxx-seq.c b/sound/soc/codecs/aw87xxx-seq.c
--- a/sound/soc/codecs/aw87xxx-seq.c	1970-01-01 05:00:00.000000000 +0500
+++ b/sound/soc/codecs/aw87xxx-seq.c	2026-11-27 06:00:45.474899076 +0500
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Awinic AW87xxx class-K speaker amplifiers driven by a register sequence.
+ *
+ * The Xiaomi Redmi Note 10 (mojito) has two of these on I2C (chip ids 0x59 and
+ * 0x5a), fed by the WCD937x AUX and EAR outputs. Their configuration is not
+ * documented; the vendor driver loads opaque register tables. This driver
+ * writes such a table (taken from the stock firmware, in the device tree) when
+ * DAPM powers the amplifier up, and switches it off again on power down.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/property.h>
+#include <sound/soc.h>
+
+#define AW87XXX_REG_ID		0x00
+
+struct aw87xxx_seq {
+	struct i2c_client *client;
+	struct gpio_desc *reset;
+	u8 *on_seq;
+	int on_len;
+	u8 *off_seq;
+	int off_len;
+};
+
+static int aw87xxx_seq_write(struct aw87xxx_seq *aw, const u8 *seq, int len)
+{
+	int i, ret;
+
+	for (i = 0; i + 1 < len; i += 2) {
+		ret = i2c_smbus_write_byte_data(aw->client, seq[i], seq[i + 1]);
+		if (ret) {
+			dev_err(&aw->client->dev, "write 0x%02x=0x%02x failed: %d\n",
+				seq[i], seq[i + 1], ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int aw87xxx_seq_drv_event(struct snd_soc_dapm_widget *w,
+				 struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	struct aw87xxx_seq *aw = snd_soc_component_get_drvdata(c);
+	static const u8 off_default[] = { 0x01, 0x00 };
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		if (aw->reset) {
+			gpiod_set_value_cansleep(aw->reset, 0);
+			usleep_range(2000, 3000);
+		}
+		return aw87xxx_seq_write(aw, aw->on_seq, aw->on_len);
+	case SND_SOC_DAPM_PRE_PMD:
+		if (aw->off_seq)
+			aw87xxx_seq_write(aw, aw->off_seq, aw->off_len);
+		else
+			aw87xxx_seq_write(aw, off_default, sizeof(off_default));
+		if (aw->reset)
+			gpiod_set_value_cansleep(aw->reset, 1);
+		return 0;
+	default:
+		return 0;
+	}
+}
+
+static const struct snd_kcontrol_new aw87xxx_seq_switch =
+	SOC_DAPM_SINGLE_VIRT("Switch", 1);
+
+static const struct snd_soc_dapm_widget aw87xxx_seq_dapm_widgets[] = {
+	SND_SOC_DAPM_INPUT("IN"),
+	SND_SOC_DAPM_SWITCH("PA", SND_SOC_NOPM, 0, 0, &aw87xxx_seq_switch),
+	SND_SOC_DAPM_OUT_DRV_E("DRV", SND_SOC_NOPM, 0, 0, NULL, 0, aw87xxx_seq_drv_event,
+			       SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_PRE_PMD),
+	SND_SOC_DAPM_OUTPUT("OUT"),
+};
+
+static const struct snd_soc_dapm_route aw87xxx_seq_dapm_routes[] = {
+	{ "PA", "Switch", "IN" },
+	{ "DRV", NULL, "PA" },
+	{ "OUT", NULL, "DRV" },
+};
+
+static const struct snd_soc_component_driver aw87xxx_seq_component = {
+	.dapm_widgets = aw87xxx_seq_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(aw87xxx_seq_dapm_widgets),
+	.dapm_routes = aw87xxx_seq_dapm_routes,
+	.num_dapm_routes = ARRAY_SIZE(aw87xxx_seq_dapm_routes),
+};
+
+static int aw87xxx_seq_read_seq(struct device *dev, const char *prop, u8 **seq, int *len)
+{
+	int n = device_property_count_u8(dev, prop);
+
+	if (n <= 0)
+		return n;
+	if (n % 2)
+		return dev_err_probe(dev, -EINVAL, "%s: odd number of bytes\n", prop);
+	*seq = devm_kmalloc(dev, n, GFP_KERNEL);
+	if (!*seq)
+		return -ENOMEM;
+	*len = n;
+	return device_property_read_u8_array(dev, prop, *seq, n);
+}
+
+static int aw87xxx_seq_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct aw87xxx_seq *aw;
+	int ret, id;
+
+	aw = devm_kzalloc(dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+	aw->client = client;
+	i2c_set_clientdata(client, aw);
+
+	/* "reset-gpios" is active low on the chip: asserted (1) = held in reset */
+	aw->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw->reset))
+		return dev_err_probe(dev, PTR_ERR(aw->reset), "failed to get reset gpio\n");
+
+	ret = aw87xxx_seq_read_seq(dev, "awinic,on-sequence", &aw->on_seq, &aw->on_len);
+	if (ret < 0)
+		return ret;
+	if (!aw->on_len)
+		return dev_err_probe(dev, -EINVAL, "awinic,on-sequence missing\n");
+	ret = aw87xxx_seq_read_seq(dev, "awinic,off-sequence", &aw->off_seq, &aw->off_len);
+	if (ret < 0)
+		return ret;
+
+	if (aw->reset) {
+		gpiod_set_value_cansleep(aw->reset, 0);
+		usleep_range(2000, 3000);
+	}
+	id = i2c_smbus_read_byte_data(client, AW87XXX_REG_ID);
+	if (aw->reset)
+		gpiod_set_value_cansleep(aw->reset, 1);
+	if (id < 0)
+		return dev_err_probe(dev, id, "no response from the amplifier\n");
+	dev_info(dev, "chip id 0x%02x, %d register writes on power up\n", id, aw->on_len / 2);
+
+	return devm_snd_soc_register_component(dev, &aw87xxx_seq_component, NULL, 0);
+}
+
+static const struct of_device_id aw87xxx_seq_of_match[] = {
+	{ .compatible = "awinic,aw87xxx-seq" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw87xxx_seq_of_match);
+
+static struct i2c_driver aw87xxx_seq_driver = {
+	.driver = {
+		.name = "aw87xxx-seq",
+		.of_match_table = aw87xxx_seq_of_match,
+	},
+	.probe = aw87xxx_seq_probe,
+};
+module_i2c_driver(aw87xxx_seq_driver);
+
+MODULE_DESCRIPTION("Awinic AW87xxx amplifier driven by a register sequence");
+MODULE_LICENSE("GPL");
diff -urN a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
--- a/sound/soc/codecs/Kconfig	2026-11-27 06:00:45.472651646 +0500
+++ b/sound/soc/codecs/Kconfig	2026-11-27 06:00:45.491842365 +0500
@@ -720,6 +720,13 @@
 	  digital Smart K audio amplifier. Due to its 9uV noise
 	  floor and ultra-low distortion, clean listening is guaranteed.
 
+config SND_SOC_AW87XXX_SEQ
+	tristate "Awinic AW87xxx amplifier (register sequence from DT)"
+	depends on I2C
+	help
+	  Awinic AW87xxx class-K speaker amplifiers configured with a register
+	  table from the device tree (as on the Xiaomi Redmi Note 10).
+
 config SND_SOC_AW87390
 	tristate "Soc Audio for awinic aw87390"
 	depends on I2C
diff -urN a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
--- a/sound/soc/codecs/Makefile	2026-11-27 06:00:45.473395777 +0500
+++ b/sound/soc/codecs/Makefile	2026-11-27 06:00:45.495721049 +0500
@@ -48,6 +48,7 @@
 snd-soc-audio-iio-aux-y := audio-iio-aux.o
 snd-soc-aw8738-y := aw8738.o
 snd-soc-aw87390-y := aw87390.o
+snd-soc-aw87xxx-seq-y := aw87xxx-seq.o
 snd-soc-aw88081-y := aw88081.o
 snd-soc-aw88395-lib-y := aw88395/aw88395_lib.o \
 			aw88395/aw88395_device.o
@@ -497,6 +498,7 @@
 obj-$(CONFIG_SND_SOC_AUDIO_IIO_AUX)	+= snd-soc-audio-iio-aux.o
 obj-$(CONFIG_SND_SOC_AW8738)	+= snd-soc-aw8738.o
 obj-$(CONFIG_SND_SOC_AW87390)	+= snd-soc-aw87390.o
+obj-$(CONFIG_SND_SOC_AW87XXX_SEQ)	+= snd-soc-aw87xxx-seq.o
 obj-$(CONFIG_SND_SOC_AW88081)	+= snd-soc-aw88081.o
 obj-$(CONFIG_SND_SOC_AW88395_LIB) += snd-soc-aw88395-lib.o
 obj-$(CONFIG_SND_SOC_AW88395)	+=snd-soc-aw88395.o
