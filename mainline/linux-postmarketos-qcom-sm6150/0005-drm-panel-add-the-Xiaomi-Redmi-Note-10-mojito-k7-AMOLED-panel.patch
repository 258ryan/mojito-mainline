From: mojito-mainline <noreply@anthropic.com>
Subject: [PATCH] drm/panel: add the Xiaomi Redmi Note 10 (mojito) k7 AMOLED panel

The 1080x2400 video-mode DSI AMOLED in the Redmi Note 10. The init sequence,
timings, reset sequence and DCS brightness range come from the stock device
tree. Brightness is a DCS command (0x51, 11 bit), exposed as a backlight.

Signed-off-by: mojito-mainline <noreply@anthropic.com>
---
diff -urN a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
--- a/drivers/gpu/drm/panel/Kconfig	2026-11-26 12:19:32.778648897 +0500
+++ b/drivers/gpu/drm/panel/Kconfig	2026-11-26 12:19:32.800258260 +0500
@@ -1467,4 +1467,16 @@
 	  Say Y here if you want to enable support for the Xinpeng
 	  XPP055C272 controller for 720x1280 LCD panels with MIPI/RGB/SPI
 	  system interfaces.
+config DRM_PANEL_XIAOMI_MOJITO_K7
+	tristate "Xiaomi Redmi Note 10 (mojito) k7 AMOLED DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_KMS_HELPER
+	help
+	  Say Y here if you want to enable support for the 1080x2400 AMOLED
+	  video-mode DSI panel in the Xiaomi Redmi Note 10 (mojito / sunny).
+	  Brightness is a DCS command, so this also registers a backlight
+	  device.
+
 endmenu
diff -urN a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
--- a/drivers/gpu/drm/panel/Makefile	2026-11-26 12:19:32.778773577 +0500
+++ b/drivers/gpu/drm/panel/Makefile	2026-11-26 12:19:32.800420625 +0500
@@ -141,3 +141,4 @@
 obj-$(CONFIG_DRM_PANEL_VISIONOX_R66451) += panel-visionox-r66451.o
 obj-$(CONFIG_DRM_PANEL_WIDECHIPS_WS2401) += panel-widechips-ws2401.o
 obj-$(CONFIG_DRM_PANEL_XINPENG_XPP055C272) += panel-xinpeng-xpp055c272.o
+obj-$(CONFIG_DRM_PANEL_XIAOMI_MOJITO_K7) += panel-xiaomi-mojito-k7.o
diff -urN a/drivers/gpu/drm/panel/panel-xiaomi-mojito-k7.c b/drivers/gpu/drm/panel/panel-xiaomi-mojito-k7.c
--- a/drivers/gpu/drm/panel/panel-xiaomi-mojito-k7.c	1970-01-01 05:00:00.000000000 +0500
+++ b/drivers/gpu/drm/panel/panel-xiaomi-mojito-k7.c	2026-11-26 12:19:32.781098816 +0500
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Xiaomi Redmi Note 10 (mojito / sunny) "k7 38 0c 0a" 1080x2400 AMOLED DSI video panel.
+ *
+ * The init and power-off sequences, the timings, the reset sequence and the DCS brightness
+ * range (0x51, 11 bit, big endian, 0..0x7ff) come from the stock downstream device tree
+ * (qcom,mdss_dsi_k7_38_0c_0a_video). The panel has no separate backlight chip: brightness is a
+ * DCS command, so the backlight device below writes 0x51.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#define MOJITO_K7_MAX_BRIGHTNESS	0x7ff
+
+struct mojito_k7 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data supplies[2];
+	struct gpio_desc *reset_gpio;
+	struct backlight_device *bl;
+	bool on;
+};
+
+static inline struct mojito_k7 *to_mojito_k7(struct drm_panel *panel)
+{
+	return container_of(panel, struct mojito_k7, panel);
+}
+
+static void mojito_k7_reset(struct mojito_k7 *ctx)
+{
+	/* Stock reset sequence: <0 1> <1 5>, i.e. 1 ms low, then high and 5 ms. */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+}
+
+static int mojito_k7_set_brightness(struct mojito_k7 *ctx, u16 brightness)
+{
+	return mipi_dsi_dcs_set_display_brightness_large(ctx->dsi, brightness);
+}
+
+static int mojito_k7_on(struct mojito_k7 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x03, 0xed);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xed, 0x40, 0x04, 0x08, 0xa8, 0x84, 0x4a, 0x73, 0x02, 0x0a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xed, 0x01, 0xcd, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe1, 0x93);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe4, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xdf, 0x09, 0x30, 0x95, 0x43, 0x99, 0x05, 0x00, 0x27,
+				     0x50, 0x2e, 0x4f, 0x7a, 0x77, 0x10, 0x3d, 0x73, 0x00, 0xff,
+				     0x01, 0x8b, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xcd, 0x04);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xcd, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x06, 0xb3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05, 0xb3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3, 0x93);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3, 0x11, 0x4f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* Write CTRL display (brightness control on), brightness 0, ACL off. */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0xb1, 0xb5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+
+	return dsi_ctx.accum_err;
+}
+
+static int mojito_k7_off(struct mojito_k7 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int mojito_k7_prepare(struct drm_panel *panel)
+{
+	struct mojito_k7 *ctx = to_mojito_k7(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+	/* vddio needs 20 ms before reset in the stock panel supply table. */
+	msleep(20);
+
+	mojito_k7_reset(ctx);
+
+	ret = mojito_k7_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "failed to initialize the panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int mojito_k7_enable(struct drm_panel *panel)
+{
+	struct mojito_k7 *ctx = to_mojito_k7(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	ctx->on = true;
+	/* Restore the brightness the backlight device asked for while the panel was off. */
+	ret = mojito_k7_set_brightness(ctx, backlight_get_brightness(ctx->bl));
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * Stock runs with display dimming on (CTRL display 0x28), so the panel fades between
+	 * brightness levels. Turn it on after the first value, so power-on does not ramp.
+	 */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x28);
+
+	return dsi_ctx.accum_err;
+}
+
+static int mojito_k7_disable(struct drm_panel *panel)
+{
+	struct mojito_k7 *ctx = to_mojito_k7(panel);
+
+	ctx->on = false;
+	return 0;
+}
+
+static int mojito_k7_unprepare(struct drm_panel *panel)
+{
+	struct mojito_k7 *ctx = to_mojito_k7(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = mojito_k7_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "failed to power the panel off: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+
+	return 0;
+}
+
+/* 1080x2400 @ 60 Hz: h 92/16/68, v 21/4/7 (stock timing node). */
+static const struct drm_display_mode mojito_k7_mode = {
+	.clock = (1080 + 92 + 16 + 68) * (2400 + 21 + 4 + 7) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 92,
+	.hsync_end = 1080 + 92 + 16,
+	.htotal = 1080 + 92 + 16 + 68,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 21,
+	.vsync_end = 2400 + 21 + 4,
+	.vtotal = 2400 + 21 + 4 + 7,
+	.width_mm = 67,
+	.height_mm = 149,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int mojito_k7_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &mojito_k7_mode);
+}
+
+static const struct drm_panel_funcs mojito_k7_panel_funcs = {
+	.prepare = mojito_k7_prepare,
+	.enable = mojito_k7_enable,
+	.disable = mojito_k7_disable,
+	.unprepare = mojito_k7_unprepare,
+	.get_modes = mojito_k7_get_modes,
+};
+
+static int mojito_k7_bl_update_status(struct backlight_device *bl)
+{
+	struct mojito_k7 *ctx = bl_get_data(bl);
+
+	/* Applied from enable() once the panel is on. */
+	if (!ctx->on)
+		return 0;
+
+	return mojito_k7_set_brightness(ctx, backlight_get_brightness(bl));
+}
+
+static const struct backlight_ops mojito_k7_bl_ops = {
+	.update_status = mojito_k7_bl_update_status,
+};
+
+static int mojito_k7_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = MOJITO_K7_MAX_BRIGHTNESS / 2,
+		.max_brightness = MOJITO_K7_MAX_BRIGHTNESS,
+	};
+	struct mojito_k7 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct mojito_k7, panel, &mojito_k7_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supplies[0].supply = "vddio";
+	ctx->supplies[1].supply = "vci";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "failed to get reset gpio\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	/* The DSI host must be in LP-11 before the init sequence (stock lp11-init). */
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->bl = devm_backlight_device_register(dev, dev_name(dev), dev, ctx, &mojito_k7_bl_ops,
+						 &props);
+	if (IS_ERR(ctx->bl))
+		return dev_err_probe(dev, PTR_ERR(ctx->bl), "failed to register the backlight\n");
+	ctx->panel.backlight = ctx->bl;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to the DSI host\n");
+	}
+
+	return 0;
+}
+
+static void mojito_k7_remove(struct mipi_dsi_device *dsi)
+{
+	struct mojito_k7 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id mojito_k7_of_match[] = {
+	{ .compatible = "xiaomi,mojito-k7-panel" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mojito_k7_of_match);
+
+static struct mipi_dsi_driver mojito_k7_driver = {
+	.probe = mojito_k7_probe,
+	.remove = mojito_k7_remove,
+	.driver = {
+		.name = "panel-xiaomi-mojito-k7",
+		.of_match_table = mojito_k7_of_match,
+	},
+};
+module_mipi_dsi_driver(mojito_k7_driver);
+
+MODULE_DESCRIPTION("Xiaomi Redmi Note 10 (mojito) k7 AMOLED DSI panel driver");
+MODULE_LICENSE("GPL");
