	0024-ASoC-qdsp6-Add-driver-for-Q6-Core-Voice-Processor-q6cvp.patch
	0025-ASoC-qdsp6-Add-driver-for-Q6-Core-Voice-Stream-q6cvs.patch
	0026-ASoC-qdsp6-Add-voice-call-functionality-in-Q6-Voice-driver.patch
	0027-ASoC-qdsp6-Add-Q6-Voice-DAI-driver-v2-1.patch
