# Mainline kernel for SM6150 ("Talos") devices, starting with Xiaomi Redmi Note 10 (mojito)
maintainer=""
_flavor="postmarketos-qcom-sm6150"
pkgname=linux-$_flavor
pkgver=7.4_rc4
pkgrel=25
pkgdesc="Mainline kernel for SM6150 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/torvalds/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	"
makedepends="
	bison
	clang
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
	zstd
"

_tag="v${pkgver/_/-}"

source="
	$pkgname-$_tag.tar.gz::$url/archive/refs/tags/$_tag.tar.gz
	config-$_flavor.$arch
	0001-arm64-dts-qcom-add-xiaomi-mojito.patch
	0002-firmware-qcom-tzmem-do-not-use-the-SHM-bridge-on-sm6150.patch
	0003-interconnect-qcom-qcs615-add-the-ACV-enable-mask.patch
	0004-Input-edt-ft5x06-read-all-10-points-on-the-FT5452.patch
	0005-drm-panel-add-the-Xiaomi-Redmi-Note-10-mojito-k7-AMOLED-panel.patch
	0006-iommu-arm-smmu-qcom-use-an-identity-domain-for-the-SM6150-MDSS.patch
	0007-drm-msm-dpu-stop-the-bootloader-timing-engine-before-the-DSI-bring-up.patch
	0008-power-supply-add-the-Qualcomm-SMB5-charger-driver.patch
	0009-iio-adc-qcom-spmi-adc5-add-BAT_THERM_100K_PU.patch
	0010-power-supply-add-a-read-only-Qualcomm-QGauge-battery-driver.patch
	0011-soc-qcom-pd-mapper-one-entry-per-domain-on-qcs615-match-sm6150.patch
	0012-rpmsg-glink-early-intents-and-intent-req-reuse.patch
	0013-pmdomain-qcom-rpmhpd-add-mss-to-qcs615.patch
	0014-iommu-arm-smmu-qcom-reserve-hyp-owned-context-banks-on-qcs615.patch
"
builddir="$srcdir/linux-${pkgver/_/-}"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 olddefconfig
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	make modules_install zinstall dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs-tmp

	mkdir -p "$pkgdir"/boot/dtbs/qcom
	cp "$pkgdir"/boot/dtbs-tmp/qcom/sm6150-* "$pkgdir"/boot/dtbs/qcom/
	rm -rf "$pkgdir"/boot/dtbs-tmp

	install -Dm644 arch/arm64/boot/Image "$pkgdir"/boot/Image

	rm -f "$pkgdir"/usr/lib/modules/*/build

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

