From: postmarketOS mojito port
Subject: [PATCH] arm64: dts: qcom: add Xiaomi Redmi Note 10 (mojito)

UFS, USB peripheral, buttons, simple-framebuffer, Xiaomi carveouts.
---
diff -urN a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
--- a/arch/arm64/boot/dts/qcom/Makefile	2026-11-25 23:43:32.325586382 +0500
+++ b/arch/arm64/boot/dts/qcom/Makefile	2026-11-25 23:43:32.328848441 +0500
@@ -390,6 +390,7 @@
 dtb-$(CONFIG_ARCH_QCOM)	+= sm6115p-lenovo-j606f.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm6125-sony-xperia-seine-pdx201.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm6125-xiaomi-ginkgo.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm6150-xiaomi-mojito.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm6125-xiaomi-laurel-sprout.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm6125-xiaomi-willow.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm6350-sony-xperia-lena-pdx213.dtb
diff -urN a/arch/arm64/boot/dts/qcom/sm6150-xiaomi-mojito.dts b/arch/arm64/boot/dts/qcom/sm6150-xiaomi-mojito.dts
--- a/arch/arm64/boot/dts/qcom/sm6150-xiaomi-mojito.dts	1970-01-01 05:00:00.000000000 +0500
+++ b/arch/arm64/boot/dts/qcom/sm6150-xiaomi-mojito.dts	2026-11-26 12:00:00.000000000 +0500
@@ -0,0 +1,547 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Redmi Note 10 (mojito / sunny), SM6150 "Talos".
+ *
+ * Phase 1: boot to a shell. UFS root, USB peripheral (SSH over USB network),
+ * buttons, and the bootloader's splash buffer as a simple-framebuffer.
+ * Display (DSI panel), GPU, remoteprocs, touch and charging come later.
+ *
+ * Regulators, supplies and carveouts are taken from the stock downstream
+ * device tree of this phone (MIUI V14.0.9.0.SKGMIXM).
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "talos.dtsi"
+#include "pm6150.dtsi"
+#include "pm6150l.dtsi"
+
+/ {
+	model = "Xiaomi Redmi Note 10";
+	compatible = "xiaomi,mojito", "qcom,sm6150";
+	chassis-type = "handset";
+
+	/* Matched by the Xiaomi bootloader (same values as the stock SM6150 DTB). */
+	qcom,msm-id = <0x163 0x0>;
+	qcom,board-id = <0 0>;
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* The bootloader leaves the panel scanning out of cont_splash. */
+		framebuffer0: framebuffer@9c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x9c000000 0x0 (1080 * 2400 * 4)>;
+			memory-region = <&cont_splash_mem>;
+			/*
+			 * Without a consumer, genpd sync_state powers mdss_core_gdsc off about 6 s after boot
+			 * (pd_ignore_unused does not stop that path) and the panel shows noisy green.
+			 */
+			power-domains = <&dispcc MDSS_CORE_GDSC>;
+			/*
+			 * Hold the display clocks the bootloader left running. Without a reference the display
+			 * clock controller's sync_state/cleanup lets the pipeline die (panel black). byte0 and
+			 * pclk0 report 0 Hz (their DSI PLL parent is registered by msm.ko) and are only gated on,
+			 * which is already their hardware state, so the bootloader's pixel timing is untouched.
+			 */
+			clocks = <&dispcc DISP_CC_MDSS_AHB_CLK>,
+				 <&dispcc DISP_CC_MDSS_MDP_CLK>,
+				 <&dispcc DISP_CC_MDSS_VSYNC_CLK>,
+				 <&dispcc DISP_CC_MDSS_ESC0_CLK>,
+				 <&dispcc DISP_CC_MDSS_BYTE0_CLK>,
+				 <&dispcc DISP_CC_MDSS_PCLK0_CLK>;
+			width = <1080>;
+			height = <2400>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	clocks {
+		/* Same SoC crystals as the QCS615 Ride (stock DT: chip_sleep_clk 32 kHz). */
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		xo_board_clk: xo-board-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <38400000>;
+			#clock-cells = <0>;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&vol_up_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			gpios = <&pm6150_gpios 2 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	reserved-memory {
+		/* Carveouts present in the stock DT but not (yet) in talos.dtsi. */
+		hyp_mem: hyp@85700000 {
+			reg = <0x0 0x85700000 0x0 0x600000>;
+			no-map;
+		};
+
+		/* XBL/AOP firmware; aop-cmd-db@85f20000 (talos.dtsi) sits right after it. */
+		xbl_aop_mem: xbl-aop@85e00000 {
+			reg = <0x0 0x85e00000 0x0 0x120000>;
+			no-map;
+		};
+
+		ipa_fw_mem: ipa-fw@97b00000 {
+			reg = <0x0 0x97b00000 0x0 0x10000>;
+			no-map;
+		};
+
+		ipa_gsi_mem: ipa-gsi@97b10000 {
+			reg = <0x0 0x97b10000 0x0 0x5000>;
+			no-map;
+		};
+
+		sec_apps_mem: sec-apps@85fff000 {
+			reg = <0x0 0x85fff000 0x0 0x1000>;
+			no-map;
+		};
+
+		removed_mem: removed@86200000 {
+			reg = <0x0 0x86200000 0x0 0x4900000>;
+			no-map;
+		};
+
+		camera_mem: camera@8ab00000 {
+			reg = <0x0 0x8ab00000 0x0 0x500000>;
+			no-map;
+		};
+
+		mpss_mem: mpss@8b000000 {
+			reg = <0x0 0x8b000000 0x0 0x8400000>;
+			no-map;
+		};
+
+		wlan_msa_mem: wlan-msa@93900000 {
+			reg = <0x0 0x93900000 0x0 0x200000>;
+			no-map;
+		};
+
+		cont_splash_mem: cont-splash@9c000000 {
+			reg = <0x0 0x9c000000 0x0 0xf00000>;
+			no-map;
+		};
+
+		dfps_data_mem: dfps-data@9cf00000 {
+			reg = <0x0 0x9cf00000 0x0 0x100000>;
+			no-map;
+		};
+
+		ramoops@9d800000 {
+			compatible = "ramoops";
+			reg = <0x0 0x9d800000 0x0 0x400000>;
+			/* same layout as the stock kernel, so either can read the other's log */
+			record-size = <0x80000>;
+			console-size = <0x100000>;
+			pmsg-size = <0x200000>;
+		};
+
+		qseecom_mem: qseecom@9e400000 {
+			reg = <0x0 0x9e400000 0x0 0x1400000>;
+			no-map;
+		};
+
+		cdsp_sec_mem: cdsp-sec@9f800000 {
+			reg = <0x0 0x9f800000 0x0 0x1e00000>;
+			no-map;
+		};
+	};
+};
+
