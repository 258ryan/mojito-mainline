069a8c289d61cb52ec47e166967e86e6856e0954d27f7b13fe107daaa53c2574aee2132080f81a8f32b091ea0bd2004c783d3929d086c2c127131510ced884c8  0001-data-add-Xiaomi-Redmi-Note-10-mojito.patch
