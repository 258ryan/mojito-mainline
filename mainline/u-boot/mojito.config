# Redmi Note 10 (mojito) additions on top of qcom_defconfig + qcom-phone.config (U-Boot v2026.10)
# Larger console record buffers: the stock 1 KiB pre-relocation buffer overflows on this phone,
# after which "fastboot oem console" only answers "Error reading console".
CONFIG_SYS_MALLOC_F_LEN=0x40000
CONFIG_CONSOLE_RECORD_OUT_SIZE_F=0x10000
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x100000
# pmOS_boot / pmOS_root live in a partition table nested inside userdata: blkmap exposes it.
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
