# Reference: <https://postmarketos.org/devicepkg>
# Based on: https://github.com/AbdulkareemQasem/Redmi-Note-10
maintainer=""
pkgname=device-xiaomi-mojito
pkgdesc="Xiaomi Redmi Note 10"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-xiaomi-mojito
	android-tools
	postmarketos-base
	postmarketos-base-downstream
"
makedepends="devicepkg-dev"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	kernel-cmdline.conf
	10-loop-4k-partscan.sh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/10-loop-4k-partscan.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks/10-loop-4k-partscan.sh
}

nonfree_firmware() {
	pkgdesc="Proprietary firmware (adsp, cdsp, modem, wifi, ...)"
	depends="firmware-xiaomi-mojito"
	mkdir "$subpkgdir"
}

