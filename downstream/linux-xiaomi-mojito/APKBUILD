e394ac5c6b0c1baa6347c367153dbb6b4b5cc498c68fefff744b42e1dbe602cf0d786e2d8d1ef88350328c06ff38209934180058ae498947a86b01203962a398  config-xiaomi-mojito.aarch64
"
